ducer\",\"type\":\"volunteer\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-harding\",\"metadata\":{\"ecosystem\":\"inside_town\"}},{\"id\":\"opp-fram-harding-2\",\"title\":\"FrameSouth — Town Photographer / Visual Proof Creator\",\"type\":\"volunteer\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-harding\",\"metadata\":{\"ecosystem\":\"framesouth\"}},{\"id\":\"opp-fixe-harding-3\",\"title\":\"FixEasy24 — Verified Service Provider Registration\",\"type\":\"opportunity\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-harding\",\"metadata\":{\"ecosystem\":\"fixeasy24\"}}],\"cv_count\":1},{\"slug\":\"estcourt\",\"name\":\"Estcourt\",\"region\":\"uMsunduzi · midlands\",\"district\":\"uMtshezi\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":32,\"heritage\":false,\"coordinator_status\":\"recruiting\",\"route\":\"/town/estcourt\",\"illustrative\":true,\"lat\":-29.0167,\"lng\":29.8833,\"description\":\"A small midlands town between Durban and the Drakensberg, Estcourt is a gateway to both the mountains and the battlefields of Isandlwana and Rorke's Drift.\",\"population_estimate\":18000,\"archetype\":\"midlands\"},{\"slug\":\"ulundi\",\"name\":\"Ulundi\",\"region\":\"Zululand · royal capital\",\"district\":\"Zululand\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"heritage\":true,\"coordinator_status\":\"recruiting\",\"route\":\"/town/ulundi\",\"illustrative\":true,\"lat\":-28.3333,\"lng\":31.4167,\"description\":\"Former capital of KwaZulu, seat of the Zulu monarchy, and site of the final battle of the Anglo-Zulu War.\"},{\"slug\":\"umlazi\",\"name\":\"Umlazi\",\"region\":\"township\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-29.9667,\"lng\":30.8833,\"description\":\"Durban's largest township, Umlazi is a community of over 200,000 where youth culture, music, and entrepreneurship create a vibrant township economy.\",\"population_estimate\":400000,\"archetype\":\"township\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/umlazi\",\"illustrative\":true},{\"slug\":\"kwamashu\",\"name\":\"KwaMashu\",\"region\":\"township\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-29.7333,\"lng\":30.95,\"description\":\"North of Durban, KwaMashu is a township built in the 1960s that has become a cultural powerhouse — home to musicians, artists, and community leaders who shaped South African music.\",\"population_estimate\":175000,\"archetype\":\"township\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/kwamashu\",\"illustrative\":true},{\"slug\":\"vryheid\",\"name\":\"Vryheid\",\"region\":\"battlefields\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-27.7667,\"lng\":30.7833,\"description\":\"A farming town in northern KZN, Vryheid serves the surrounding coal mining and agricultural communities. The nearby battlefields tell the story of the Anglo-Zulu War.\",\"population_estimate\":25000,\"archetype\":\"battlefields\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/vryheid\",\"illustrative\":true},{\"slug\":\"ladysmith\",\"name\":\"Ladysmith\",\"region\":\"battlefields\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-28.5667,\"lng\":29.7833,\"description\":\"Famous for the 118-day Siege during the Anglo-Boer War, Ladysmith is a KZN town with deep military heritage and dramatic Drakensberg views.\",\"population_estimate\":20000,\"archetype\":\"battlefields\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/ladysmith\",\"illustrative\":true},{\"slug\":\"hluhluwe\",\"name\":\"Hluhluwe\",\"region\":\"wildlife\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-28.0833,\"lng\":32.0667,\"description\":\"The gateway to the Hluhluwe-iMfolozi Park, the world's oldest game reserve where white rhinos were saved from extinction. This is Big Five country.\",\"population_estimate\":5000,\"archetype\":\"wildlife\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/hluhluwe\",\"illustrative\":true},{\"slug\":\"st-lucia\",\"name\":\"St Lucia\",\"region\":\"ecotourism\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-27.4,\"lng\":32.4333,\"description\":\"The Estuary of the iSimangaliso Wetland Park — a UNESCO World Heritage Site where hippos wander the streets and crocodiles sun on the riverbank.\",\"population_estimate\":3000,\"archetype\":\"ecotourism\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/st-lucia\",\"illustrative\":true}],\"hero_image\":\"https://images.unsplash.com/photo-1573790387438-4da905039392?w=1200&q=80\",\"description\":\"Where the Indian Ocean meets Zulu heritage. 12 towns from Durban's golden beaches to the Drakensberg mountains, blending subtropical warmth with deep cultural roots.\"}},\"province\":\"$5:props:town:_province\",\"lens\":\"investor\"}]\nb:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n7:null\n9:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Pietermaritzburg — Ubuntu Town Digital Twin | Ubuntu Town\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"The City of Flowers and capital of KZN, Pietermaritzburg is where Gandhi was thrown off a train and where the Midlands Meander craft route begins. Historic b...\"}],[\"$\",\"link\",\"2\",{\"rel\":\"author\",\"href\":\"https://kekelebaka.com\"}],[\"$\",\"meta\",\"3\",{\"name\":\"author\",\"content\":\"Keke Lebaka\"}],[\"$\",\"meta\",\"4\",{\"name\":\"keywords\",\"content\":\"Ubuntu Town,South Africa,town coordinator,opportunity infrastructure,CV engine,workpacks,proof-based work,agentic economy,Ubuntu Intelligence,Kopano,ambassador network,community coordination,small towns,townships,job matching\"}],[\"$\",\"meta\",\"5\",{\"name\":\"creator\",\"content\":\"Keke Lebaka\"}],[\"$\",\"meta\",\"6\",{\"name\":\"publisher\",\"con