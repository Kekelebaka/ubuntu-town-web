pe heritage.\\\",\\\"population_estimate\\\":110000,\\\"archetype\\\":\\\"winelands_town\\\",\\\"opportunities\\\":[{\\\"id\\\":\\\"opp-kasi-paarl\\\",\\\"title\\\":\\\"KasiBuy — Local Spaza / WhatsApp Store Listing\\\",\\\"type\\\":\\\"opportunity\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-paarl\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"kasibuy\\\"}},{\\\"id\\\":\\\"opp-fami-paarl-2\\\",\\\"title\\\":\\\"FamilyHouse — Home Hospitality Host Registration\\\",\\\"type\\\":\\\"opportunity\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-paarl\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"familyhouse\\\"}},{\\\"id\\\":\\\"opp-ecoc-paarl-3\\\",\\\"title\\\":\\\"EcoChar — 5-Day Charcoal Production Training\\\",\\\"type\\\":\\\"training\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-paarl\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"ecochar\\\"}}]},{\\\"slug\\\":\\\"knysna\\\",\\\"name\\\":\\\"Knysna\\\",\\\"region\\\":\\\"Garden Route · lagoon \\u0026 forest\\\",\\\"district\\\":\\\"Garden Route\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":48,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/knysna\\\",\\\"illustrative\\\":true,\\\"lat\\\":-34.0362,\\\"lng\\\":23.0475,\\\"description\\\":\\\"The Jewel of the Garden Route, Knysna wraps around a vast lagoon between two dramatic headlands, with indigenous forest, oyster farms, and the famous Knysna Heads creating one of South Africa's most beautiful settings.\\\",\\\"population_estimate\\\":52000,\\\"archetype\\\":\\\"garden_route\\\",\\\"businesses\\\":[{\\\"slug\\\":\\\"knysna\\\",\\\"name\\\":\\\"Knysna Heads Restaurant\\\",\\\"category\\\":\\\"food\\\",\\\"is_verified\\\":false,\\\"id\\\":\\\"seed-knysna-biz\\\",\\\"town_id\\\":null}],\\\"events\\\":[{\\\"slug\\\":\\\"knysna\\\",\\\"title\\\":\\\"Knysna Oyster Festival\\\",\\\"description\\\":\\\"Food, sport, and oysters on the Garden Route\\\",\\\"event_date\\\":\\\"2026-07-01\\\",\\\"id\\\":\\\"seed-knysna-evt\\\",\\\"town_id\\\":null}]},{\\\"slug\\\":\\\"hermanus\\\",\\\"name\\\":\\\"Hermanus\\\",\\\"region\\\":\\\"Overberg · whale coast\\\",\\\"district\\\":\\\"Overberg\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":46,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/hermanus\\\",\\\"illustrative\\\":true,\\\"lat\\\":-34.4172,\\\"lng\\\":19.2345,\\\"description\\\":\\\"South Africa's premier whale-watching destination, Hermanus hosts the annual Whale Festival when southern right whales arrive in Walker Bay. The Hemel-en-Aarde Valley behind the town produces world-class Pinot Noir and Chardonnay.\\\",\\\"population_estimate\\\":12000,\\\"archetype\\\":\\\"coastal_town\\\",\\\"businesses\\\":[{\\\"slug\\\":\\\"hermanus\\\",\\\"name\\\":\\\"Hermanus Whale Watching\\\",\\\"category\\\":\\\"tourism\\\",\\\"is_verified\\\":false,\\\"id\\\":\\\"seed-hermanus-biz\\\",\\\"town_id\\\":null}],\\\"events\\\":[{\\\"slug\\\":\\\"hermanus\\\",\\\"title\\\":\\\"Whale Festival\\\",\\\"description\\\":\\\"Celebration of the southern right whale season\\\",\\\"event_date\\\":\\\"2026-10-01\\\",\\\"id\\\":\\\"seed-hermanus-evt\\\",\\\"town_id\\\":null}]},{\\\"slug\\\":\\\"mossel-bay\\\",\\\"name\\\":\\\"Mossel Bay\\\",\\\"region\\\":\\\"Garden Route · coast \\u0026 energy\\\",\\\"district\\\":\\\"Garden Route\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":45,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/mossel-bay\\\",\\\"illustrative\\\":true,\\\"lat\\\":-34.175,\\\"lng\\\":22.1353,\\\"description\\\":\\\"Where Bartholomew Diaz first landed in 1488, Mossel Bay is a coastal town where history meets surf culture. The Dias Museum, the Post Office Tree, and golden beaches tell a story of discovery and ocean life spanning centuries.\\\",\\\"population_estimate\\\":59000,\\\"archetype\\\":\\\"coastal_town\\\"},{\\\"slug\\\":\\\"oudtshoorn\\\",\\\"name\\\":\\\"Oudtshoorn\\\",\\\"region\\\":\\\"Garden Route · Klein Karoo \\u0026 Cango Caves\\\",\\\"district\\\":\\\"Garden Route\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":44,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/oudtshoorn\\\",\\\"illustrative\\\":true,\\\"lat\\\":-33.5833,\\\"lng\\\":22.2,\\\"description\\\":\\\"Ostrich capital of South Africa, home to the famous Cango Caves and annual Klein Karoo Nasionale Kunstefees.\\\"},{\\\"slug\\\":\\\"saldanha\\\",\\\"name\\\":\\\"Saldanha\\\",\\\"region\\\":\\\"West Coast · port \\u0026 industry\\\",\\\"district\\\":\\\"West Coast\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":42,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/saldanha\\\",\\\"illustrative\\\":true,\\\"lat\\\":-33.0167,\\\"lng\\\":17.9333,\\\"description\\\":\\\"Deep-water port town on the West Coast, industrial hub and gateway to the West Coast National Park.\\\"},{\\\"slug\\\":\\\"swellendam\\\",\\\"name\\\":\\\"Swellendam\\\",\\\"region\\\":\\\"Overberg · historic Cape\\\",\\\"district\\\":\\\"Overberg\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":38,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/swellendam\\\",\\\"illustrative\\\":true,\\\"lat\\\":-34.0237,\\\"lng\\\":20.4524,\\\"description\\\":\\\"One of the oldest towns in South Africa, Swellendam is a heritage gem with perfectly preserved Cape Dutch buildings, art galleries, and the annual Berry Festival. The Bontebok National Park nearby protects one of the rarest antelope species on earth.\\\",\\\"population_estimate\\\":8000,\\\"archetype\\\":\\\"heritage_town\\\"},{\\\"slug\\\":\\\"grabouw\\\",