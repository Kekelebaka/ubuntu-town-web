\\\":18.8602,\\\"description\\\":\\\"South Africa's second-oldest town and wine capital, Stellenbosch combines centuries-old Cape Dutch architecture with a thriving university town energy. Oak-lined streets, world-class vineyards, and a buzzing food scene make it both historic and thoroughly modern.\\\",\\\"population_estimate\\\":180000,\\\"archetype\\\":\\\"university_town\\\",\\\"opportunities\\\":[{\\\"id\\\":\\\"opp-family-stell\\\",\\\"title\\\":\\\"FamilyHouse — Home Host \\u0026 Accommodation Partner\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-stell\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"familyhouse\\\"}}],\\\"signals\\\":[{\\\"id\\\":\\\"sig-stell-1\\\",\\\"title\\\":\\\"Streetlight repair — Bird Street\\\",\\\"category\\\":\\\"infrastructure\\\",\\\"status\\\":\\\"resolved\\\",\\\"town_id\\\":\\\"town-stell\\\"}],\\\"businesses\\\":[{\\\"id\\\":\\\"biz-stell-1\\\",\\\"name\\\":\\\"Kayamandi Crafts Collective\\\",\\\"category\\\":\\\"retail\\\",\\\"is_verified\\\":true,\\\"town_id\\\":\\\"town-stell\\\"},{\\\"slug\\\":\\\"stellenbosch\\\",\\\"name\\\":\\\"Stellenbosch Wine Estates\\\",\\\"category\\\":\\\"food\\\",\\\"is_verified\\\":false,\\\"id\\\":\\\"seed-stellenbosch-biz\\\",\\\"town_id\\\":null}]},{\\\"slug\\\":\\\"george\\\",\\\"name\\\":\\\"George\\\",\\\"region\\\":\\\"Garden Route · regional hub\\\",\\\"district\\\":\\\"Garden Route\\\",\\\"status\\\":\\\"building\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":55,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"assigned\\\",\\\"route\\\":\\\"/town/george\\\",\\\"illustrative\\\":true,\\\"coordinator_name\\\":\\\"Anele Swarts\\\",\\\"lat\\\":-33.9608,\\\"lng\\\":22.4617,\\\"description\\\":\\\"Gateway to the Garden Route, George is nestled between the Outeniqua Mountains and the Indian Ocean, offering access to some of South Africa's most stunning natural landscapes. The town is a hub for outdoor adventure — hik