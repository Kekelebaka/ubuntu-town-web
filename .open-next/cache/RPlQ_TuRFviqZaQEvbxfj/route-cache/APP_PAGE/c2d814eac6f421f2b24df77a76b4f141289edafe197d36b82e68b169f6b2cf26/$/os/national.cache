{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/os/layout,_N_T_/os/national/layout,_N_T_/os/national/page,_N_T_/os/national"},"routeCache":{"key":"/route-cache/APP_PAGE/c2d814eac6f421f2b24df77a76b4f141289edafe197d36b82e68b169f6b2cf26/$/os/national","owner":{"kind":"APP_PAGE","sourceRoute":"/os/national/page"},"isFallback":false}},"html":"<!DOCTYPE html><!--RPlQ_TuRFviqZaQEvbxfj--><html lang=\"en\" class=\"__variable_677553 __variable_9488e0 __variable_1243c3 __variable_7e0dc4 __variable_c512e9\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/19c94aeec6c506c0-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/46bdd75a3ff56824-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/8fb1a96451cec840-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/953b7aa585d36a2b-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/98e207f02528a563-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/9d5a263311222317-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/b7b43acee81d05a8-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/bc2f1495f01b0d00-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/db96af6b531dc71f-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/ef6d3f52c547a6e3-s.p.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/css/b791ac94b61bc051.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/1aa95146c26fcd7a.css\" data-precedence=\"next\"/><link rel=\"stylesheet\" href=\"/_next/static/css/f56fff398e110a85.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-2c226e022979f4f0.js\"/><script src=\"/_next/static/chunks/c52203ab-6d165ddd5d436ef1.js\" async=\"\"></script><script src=\"/_next/static/chunks/1531-54cae2885030f668.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-28b0572774546a88.js\" async=\"\"></script><script src=\"/_next/static/chunks/8365-9ab4d235ee694a56.js\" async=\"\"></script><script src=\"/_next/static/chunks/1260-776d8aa4dcb6f1be.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/os/national/page-d02b017ac745674e.js\" async=\"\"></script><script src=\"/_next/static/chunks/2287-0e3cba6948750673.js\" async=\"\"></script><script src=\"/_next/static/chunks/6208-abc94ac1352b1d93.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-dd01292aadafd0f5.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><link rel=\"icon\" href=\"/icons/icon-192.png\" sizes=\"any\"/><meta name=\"theme-color\" content=\"#6B1F66\"/><meta name=\"msapplication-TileColor\" content=\"#6B1F66\"/><link rel=\"manifest\" href=\"/manifest.webmanifest\"/><link rel=\"apple-touch-icon\" href=\"/icons/apple-touch-icon.png\"/><meta name=\"apple-mobile-web-app-capable\" content=\"yes\"/><meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\"/><meta name=\"apple-mobile-web-app-title\" content=\"Ubuntu Town\"/><meta name=\"mobile-web-app-capable\" content=\"yes\"/><title>Ubuntu Town OS — Experience 001 | Ubuntu Town</title><meta name=\"description\" content=\"Build the person. Build the initiative. Build the town. Synthetic demo experience.\"/><link rel=\"author\" href=\"https://kekelebaka.com\"/><meta name=\"author\" content=\"Keke Lebaka\"/><meta name=\"keywords\" content=\"Ubuntu Town,South Africa,town coordinator,opportunity infrastructure,CV engine,workpacks,proof-based work,agentic economy,Ubuntu Intelligence,Kopano,ambassador network,community coordination,small towns,townships,job matching\"/><meta name=\"creator\" content=\"Keke Lebaka\"/><meta name=\"publisher\" content=\"Ubuntu Town\"/><meta name=\"robots\" content=\"index, follow\"/><meta name=\"googlebot\" content=\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"/><link rel=\"alternate\" type=\"application/json\" href=\"https://enter.ubuntutown.co.za/ubuntu-town.json\"/><meta property=\"og:title\" content=\"Ubuntu Town — Community Opportunity Infrastructure for South Africa\"/><meta property=\"og:description\" content=\"Ubuntu Town OS builds community opportunity infrastructure for South African towns. Connecting communities with verified opportunities, CV creation, and coordinator networks.\"/><meta property=\"og:url\" content=\"https://www.ubuntutown.co.za\"/><meta property=\"og:site_name\" content=\"Ubuntu Town — 1 Million CVs. 1 Million Opportunities.\"/><meta property=\"og:locale\" content=\"en_ZA\"/><meta property=\"og:image\" content=\"https://www.ubuntutown.co.za/ubuntu-town-logo-512.png\"/><meta property=\"og:image:width\" content=\"512\"/><meta property=\"og:image:height\" content=\"512\"/><meta property=\"og:image:alt\" content=\"Ubuntu Town — 1 Million CVs. 1 Million Opportunities.\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:creator\" content=\"@kekelebaka\"/><meta name=\"twitter:title\" content=\"Ubuntu Town — 1 Million CVs. 1 Million Opportunities.\"/><meta name=\"twitter:description\" content=\"Community opportunity infrastructure for South African towns. Connecting communities with verified opportunities, CV creation, and coordinator networks.\"/><meta name=\"twitter:image\" content=\"https://www.ubuntutown.co.za/ubuntu-town-logo-512.png\"/><script defer=\"\" data-domain=\"enter.ubuntutown.co.za\" src=\"https://plausible.io/js/script.js\"></script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://www.ubuntutown.co.za/#organization\",\"name\":\"Ubuntu Town\",\"alternateName\":[\"Ubuntu Town OS\",\"UTown\"],\"description\":\"Community opportunity infrastructure for South African towns. When AI agents allocate opportunity, communities without structured, trusted data don't exist — Ubuntu Town builds the data layer first.\",\"url\":\"https://www.ubuntutown.co.za\",\"tagline\":\"1 Million CVs. 1 Million Opportunities.\",\"motto\":\"One Town. Many Hands. U > I\",\"foundingLocation\":{\"@type\":\"Place\",\"address\":{\"@type\":\"PostalAddress\",\"addressCountry\":\"ZA\"}},\"foundingDate\":\"2025-2026\",\"founder\":{\"@type\":\"Person\",\"name\":\"Keke Lebaka\",\"url\":\"https://kekelebaka.com\"},\"sameAs\":[\"https://kekelebaka.com\",\"https://t.me/UbuntuTown\"],\"contactPoint\":{\"@type\":\"ContactPoint\",\"email\":\"info@ubuntutown.co.za\",\"contactType\":\"general inquiry\"},\"keywords\":[\"Ubuntu Town\",\"opportunity infrastructure\",\"town coordinator\",\"CV engine\",\"proof\",\"workpacks\",\"South Africa\",\"agentic economy\",\"community coordination\",\"Ubuntu Intelligence\"],\"knowsAbout\":[\"opportunity infrastructure\",\"town coordination\",\"CV creation\",\"proof-based work\",\"agentic economy\",\"community development\",\"Ubuntu Intelligence\"]},{\"@type\":\"WebSite\",\"@id\":\"https://www.ubuntutown.co.za/#website\",\"url\":\"https://www.ubuntutown.co.za\",\"name\":\"Ubuntu Town — 1 Million CVs. 1 Million Opportunities.\",\"description\":\"Community opportunity infrastructure for South African towns.\",\"inLanguage\":\"en\",\"publisher\":{\"@id\":\"https://www.ubuntutown.co.za/#organization\"}},{\"@type\":\"WebApplication\",\"@id\":\"https://www.ubuntutown.co.za/#webapp\",\"name\":\"Ubuntu Town OS\",\"description\":\"Community coordination platform for South African towns. Connects communities with opportunities, CV creation, and coordinator networks.\",\"url\":\"https://www.ubuntutown.co.za\",\"applicationCategory\":\"SocialApplication\",\"operatingSystem\":\"Web (mobile-first)\",\"browserRequirements\":\"Requires JavaScript\",\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"ZAR\",\"description\":\"Free access for individuals and communities\"}}]}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><script>var __name=(f,n)=>f;</script><script>((a,b,c,d,e,f,g,h)=>{let i=document.documentElement,j=[\"light\",\"dark\"];function k(b){var c;(Array.isArray(a)?a:[a]).forEach(a=>{let c=\"class\"===a,d=c&&f?e.map(a=>f[a]||a):e;c?(i.classList.remove(...d),i.classList.add(f&&f[b]?f[b]:b)):i.setAttribute(a,b)}),c=b,h&&j.includes(c)&&(i.style.colorScheme=c)}if(d)k(d);else try{let a=localStorage.getItem(b)||c,d=g&&\"system\"===a?window.matchMedia(\"(prefers-color-scheme: dark)\").matches?\"dark\":\"light\":a;k(d)}catch(a){}})(\"class\",\"theme\",\"light\",null,[\"light\",\"dark\"],null,false,true)</script><div class=\"min-h-screen bg-[#FAF5EE] text-[#241A33]\"><div class=\"bg-[#3B1A5E] px-4 py-2 text-center text-[11px] font-semibold uppercase tracking-[0.18em] text-[#F5C97E]\">Experience 001 · Synthetic demo data — nothing here is real production data</div><header class=\"border-b border-[#EADFD2] bg-white/80 backdrop-blur\"><div class=\"mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4\"><a class=\"flex items-center gap-2\" href=\"/os\"><span class=\"flex h-9 w-9 items-center justify-center rounded-xl bg-[#5B2A86] text-sm font-black text-white\">UT</span><span><span class=\"block text-sm font-bold leading-none text-[#241A33]\">UBUNTU TOWN OS</span><span class=\"block text-[10px] uppercase tracking-[0.18em] text-[#B2600E]\">The town is moving</span></span></a><nav class=\"flex flex-wrap items-center gap-1 text-xs font-semibold\"><a class=\"rounded-full px-3 py-1.5 text-[#5B2A86] hover:bg-[#F3EBFA]\" href=\"/os/national\">National</a><a class=\"rounded-full px-3 py-1.5 text-[#5B2A86] hover:bg-[#F3EBFA]\" href=\"/os/national#provinces\">Provinces</a><a class=\"rounded-full px-3 py-1.5 text-[#5B2A86] hover:bg-[#F3EBFA]\" href=\"/os/town/senekal\">Senekal</a><a class=\"rounded-full px-3 py-1.5 text-[#5B2A86] hover:bg-[#F3EBFA]\" href=\"/os/initiative/syn-init-fixeasy-senekal\">FixEasy</a><a class=\"rounded-full px-3 py-1.5 text-[#5B2A86] hover:bg-[#F3EBFA]\" href=\"/os/town/senekal#people\">People</a></nav></div></header><main class=\"mx-auto max-w-6xl px-6 py-10\"><div><nav class=\"mb-6 flex flex-wrap items-center gap-1.5 text-xs text-[#8B7FA3]\"><span class=\"flex items-center gap-1.5\"><a class=\"font-medium text-[#5B2A86] hover:underline\" href=\"/os\">Ubuntu Town OS</a></span><span class=\"flex items-center gap-1.5\"><span class=\"text-[#C9BED6]\">→</span><span class=\"font-semibold text-[#5A4E6D]\">National</span></span></nav><header class=\"mb-8\"><p class=\"text-xs font-semibold uppercase tracking-[0.22em] text-[#B2600E]\">National Pulse</p><h1 class=\"mt-2 text-3xl font-bold leading-tight text-[#241A33] sm:text-4xl\">What is changing across Ubuntu Town?</h1><p class=\"mt-2 max-w-2xl text-base text-[#5A4E6D]\">One intelligence system resolving at national level. National is a distinct job: it sees patterns, capacity and risk — not tasks.</p></header><div class=\"rounded-2xl border border-[#EADFD2] bg-white p-5 shadow-sm \"><div class=\"grid grid-cols-2 gap-6 sm:grid-cols-4 lg:grid-cols-6\"><div><p class=\"text-2xl font-bold text-[#5B2A86]\">21</p><p class=\"mt-1 text-xs uppercase tracking-[0.12em] text-[#8B7FA3]\">works tracked</p></div><div><p class=\"text-2xl font-bold text-[#B2600E]\">15</p><p class=\"mt-1 text-xs uppercase tracking-[0.12em] text-[#8B7FA3]\">open work</p></div><div><p class=\"text-2xl font-bold text-[#2F7D5C]\">6</p><p class=\"mt-1 text-xs uppercase tracking-[0.12em] text-[#8B7FA3]\">published</p></div><div><p class=\"text-2xl font-bold text-[#2F7D5C]\">11</p><p class=\"mt-1 text-xs uppercase tracking-[0.12em] text-[#8B7FA3]\">proofs captured</p></div><div><p class=\"text-2xl font-bold text-[#C2453B]\">6</p><p class=\"mt-1 text-xs uppercase tracking-[0.12em] text-[#8B7FA3]\">stalled work</p></div><div><p class=\"text-2xl font-bold text-[#241A33]\">7</p><p class=\"mt-1 text-xs uppercase tracking-[0.12em] text-[#8B7FA3]\">active people</p></div></div><p class=\"mt-4 text-xs text-[#8B7FA3]\">Proof capture rate <!-- -->183%<!-- --> · computed by the ONE derived engine over the same rows as every other view.</p></div><section class=\"mt-10\"><h2 class=\"text-sm font-bold uppercase tracking-[0.22em] text-[#8B7FA3]\">Operating categories</h2><div class=\"mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2\"><div class=\"rounded-2xl border border-[#EADFD2] bg-white p-5 shadow-sm \"><div class=\"flex items-baseline justify-between\"><p class=\"text-xs font-bold uppercase tracking-[0.16em] text-[#B2600E]\">MOMENTUM</p><p class=\"text-[10px] italic text-[#8B7FA3]\">Where activity is accelerating</p></div><p class=\"mt-2 text-sm leading-relaxed text-[#241A33]\">Soweto FrameSouth + Senekal FixEasy + Phuthaditjhaba ECD are accelerating.</p><div class=\"mt-3\"><span class=\"flex flex-wrap gap-1\"><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/mission/syn-work-102\">syn-work-102</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/mission/syn-work-201\">syn-work-201</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/mission/syn-work-601\">syn-work-601</a></span></div></div><div class=\"rounded-2xl border border-[#EADFD2] bg-white p-5 shadow-sm \"><div class=\"flex items-baseline justify-between\"><p class=\"text-xs font-bold uppercase tracking-[0.16em] text-[#B2600E]\">CAPACITY</p><p class=\"text-[10px] italic text-[#8B7FA3]\">Where capability is missing</p></div><p class=\"mt-2 text-sm leading-relaxed text-[#241A33]\">Verified supply trails demand in 4 of 6 initiatives (artisan, ECD, carer, producer).</p><div class=\"mt-3\"><span class=\"flex flex-wrap gap-1\"><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/town/klerksdorp\">syn-signal-201</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/town/klerksdorp\">syn-signal-601</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/town/klerksdorp\">syn-signal-501</a></span></div></div><div class=\"rounded-2xl border border-[#EADFD2] bg-white p-5 shadow-sm \"><div class=\"flex items-baseline justify-between\"><p class=\"text-xs font-bold uppercase tracking-[0.16em] text-[#B2600E]\">MISSION RISK</p><p class=\"text-[10px] italic text-[#8B7FA3]\">Where work is stalling</p></div><p class=\"mt-2 text-sm leading-relaxed text-[#241A33]\">Trade Bridge Mthatha: 5 works blocked &gt; 30 days. Senekal: 1 compliance block.</p><div class=\"mt-3\"><span class=\"flex flex-wrap gap-1\"><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/mission/syn-work-504\">syn-work-504</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/mission/syn-work-206\">syn-work-206</a></span></div></div><div class=\"rounded-2xl border border-[#EADFD2] bg-white p-5 shadow-sm \"><div class=\"flex items-baseline justify-between\"><p class=\"text-xs font-bold uppercase tracking-[0.16em] text-[#B2600E]\">PROOF GAPS</p><p class=\"text-[10px] italic text-[#8B7FA3]\">Where work exists but evidence is missing</p></div><p class=\"mt-2 text-sm leading-relaxed text-[#241A33]\">Care Collective 2/9 proofs verified. Trade Bridge 8 proofs missing.</p><div class=\"mt-3\"><span class=\"flex flex-wrap gap-1\"><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/mission/syn-work-701\">syn-work-701</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/proof/syn-proof-710\">syn-proof-710</a></span></div></div><div class=\"rounded-2xl border border-[#EADFD2] bg-white p-5 shadow-sm \"><div class=\"flex items-baseline justify-between\"><p class=\"text-xs font-bold uppercase tracking-[0.16em] text-[#B2600E]\">ECONOMIC SIGNALS</p><p class=\"text-[10px] italic text-[#8B7FA3]\">Where demand, transactions, earnings or opportunity are moving</p></div><p class=\"mt-2 text-sm leading-relaxed text-[#241A33]\">R148.5k verified work value (Senekal), R96.2k creator earnings (Soweto), R210k indicative demand (Klerksdorp).</p><div class=\"mt-3\"><span class=\"flex flex-wrap gap-1\"><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/mission/syn-work-201\">syn-work-201</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/mission/syn-work-101\">syn-work-101</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/town/klerksdorp\">syn-signal-801</a></span></div></div><div class=\"rounded-2xl border border-[#EADFD2] bg-white p-5 shadow-sm \"><div class=\"flex items-baseline justify-between\"><p class=\"text-xs font-bold uppercase tracking-[0.16em] text-[#B2600E]\">PEOPLE</p><p class=\"text-[10px] italic text-[#8B7FA3]\">Where people are progressing, stalled or emerging</p></div><p class=\"mt-2 text-sm leading-relaxed text-[#241A33]\">1 builder ready for progression (Palesa), 1 scope request without evidence (Sipho), 1 proof-discipline case (Bongani).</p><div class=\"mt-3\"><span class=\"flex flex-wrap gap-1\"><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/person/syn-person-palesa\">syn-person-palesa</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/person/syn-person-sipho\">syn-person-sipho</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/person/syn-person-bongani\">syn-person-bongani</a></span></div></div><div class=\"rounded-2xl border border-[#EADFD2] bg-white p-5 shadow-sm \"><div class=\"flex items-baseline justify-between\"><p class=\"text-xs font-bold uppercase tracking-[0.16em] text-[#B2600E]\">OPPORTUNITY</p><p class=\"text-[10px] italic text-[#8B7FA3]\">Where the system detects something worth pursuing</p></div><p class=\"mt-2 text-sm leading-relaxed text-[#241A33]\">Cross-town pilot: Klerksdorp demand × Senekal verified supply.</p><div class=\"mt-3\"><span class=\"flex flex-wrap gap-1\"><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/opportunity/syn-opp-901\">syn-opp-901</a></span></div></div><div class=\"rounded-2xl border border-[#EADFD2] bg-white p-5 shadow-sm \"><div class=\"flex items-baseline justify-between\"><p class=\"text-xs font-bold uppercase tracking-[0.16em] text-[#B2600E]\">NEXT ACTION</p><p class=\"text-[10px] italic text-[#8B7FA3]\">What the operating system recommends doing</p></div><p class=\"mt-2 text-sm leading-relaxed text-[#241A33]\">Fund two verification rounds; proof-recovery mission before stipends; intervention review in Mthatha.</p><div class=\"mt-3\"><span class=\"flex flex-wrap gap-1\"><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/mission/syn-work-204\">syn-work-204</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/mission/syn-work-702\">syn-work-702</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/mission/syn-work-502\">syn-work-502</a></span></div></div></div></section><section id=\"provinces\" class=\"mt-12\"><h2 class=\"text-sm font-bold uppercase tracking-[0.22em] text-[#8B7FA3]\">Province resolution — 9 provinces</h2><div class=\"mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5\"><a class=\"rounded-2xl border border-[#EADFD2] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-[#D9B27C]\" href=\"/os/province/gauteng\"><p class=\"text-sm font-bold text-[#241A33]\">Gauteng</p><p class=\"mt-1 text-xs text-[#5A4E6D]\">8<!-- --> Blueprint towns</p></a><a class=\"rounded-2xl border border-[#EADFD2] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-[#D9B27C]\" href=\"/os/province/free-state\"><p class=\"text-sm font-bold text-[#241A33]\">Free State</p><p class=\"mt-1 text-xs text-[#5A4E6D]\">8<!-- --> Blueprint towns</p></a><a class=\"rounded-2xl border border-[#EADFD2] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-[#D9B27C]\" href=\"/os/province/kwazulu-natal\"><p class=\"text-sm font-bold text-[#241A33]\">KwaZulu-Natal</p><p class=\"mt-1 text-xs text-[#5A4E6D]\">7<!-- --> Blueprint towns</p></a><a class=\"rounded-2xl border border-[#EADFD2] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-[#D9B27C]\" href=\"/os/province/eastern-cape\"><p class=\"text-sm font-bold text-[#241A33]\">Eastern Cape</p><p class=\"mt-1 text-xs text-[#5A4E6D]\">5<!-- --> Blueprint towns</p></a><a class=\"rounded-2xl border border-[#EADFD2] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-[#D9B27C]\" href=\"/os/province/mpumalanga\"><p class=\"text-sm font-bold text-[#241A33]\">Mpumalanga</p><p class=\"mt-1 text-xs text-[#5A4E6D]\">6<!-- --> Blueprint towns</p></a><a class=\"rounded-2xl border border-[#EADFD2] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-[#D9B27C]\" href=\"/os/province/limpopo\"><p class=\"text-sm font-bold text-[#241A33]\">Limpopo</p><p class=\"mt-1 text-xs text-[#5A4E6D]\">4<!-- --> Blueprint towns</p></a><a class=\"rounded-2xl border border-[#EADFD2] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-[#D9B27C]\" href=\"/os/province/north-west\"><p class=\"text-sm font-bold text-[#241A33]\">North West</p><p class=\"mt-1 text-xs text-[#5A4E6D]\">4<!-- --> Blueprint towns</p></a><a class=\"rounded-2xl border border-[#EADFD2] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-[#D9B27C]\" href=\"/os/province/western-cape\"><p class=\"text-sm font-bold text-[#241A33]\">Western Cape</p><p class=\"mt-1 text-xs text-[#5A4E6D]\">4<!-- --> Blueprint towns</p></a><a class=\"rounded-2xl border border-[#EADFD2] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-[#D9B27C]\" href=\"/os/province/northern-cape\"><p class=\"text-sm font-bold text-[#241A33]\">Northern Cape</p><p class=\"mt-1 text-xs text-[#5A4E6D]\">4<!-- --> Blueprint towns</p></a></div></section><section class=\"mt-12\"><h2 class=\"text-sm font-bold uppercase tracking-[0.22em] text-[#8B7FA3]\">Initiative network</h2><div class=\"mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3\"><a class=\"rounded-2xl border border-[#EADFD2] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-[#D9B27C]\" href=\"/os/initiative/syn-init-fixeasy-senekal\"><p class=\"text-sm font-bold text-[#5B2A86]\">FixEasy</p><p class=\"mt-1 text-xs text-[#5A4E6D]\">Verified repair work, matched to local demand.</p></a><a class=\"rounded-2xl border border-[#EADFD2] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-[#D9B27C]\" href=\"/os/initiative/syn-init-framesouth-soweto\"><p class=\"text-sm font-bold text-[#5B2A86]\">FrameSouth</p><p class=\"mt-1 text-xs text-[#5A4E6D]\">A creator guild turning local stories into paid work.</p></a><a class=\"rounded-2xl border border-[#EADFD2] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-[#D9B27C]\" href=\"/os/initiative/syn-init-ecd-phuthaditjhaba\"><p class=\"text-sm font-bold text-[#5B2A86]\">Green Streets ECD</p><p class=\"mt-1 text-xs text-[#5A4E6D]\">Community early childhood development capacity.</p></a><a class=\"rounded-2xl border border-[#EADFD2] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-[#D9B27C]\" href=\"/os/initiative/syn-init-tradebridge-mthatha\"><p class=\"text-sm font-bold text-[#5B2A86]\">Trade Bridge</p><p class=\"mt-1 text-xs text-[#5A4E6D]\">Linking township producers to buyers.</p></a><a class=\"rounded-2xl border border-[#EADFD2] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-[#D9B27C]\" href=\"/os/initiative/syn-init-care-bushbuckridge\"><p class=\"text-sm font-bold text-[#5B2A86]\">Care Collective</p><p class=\"mt-1 text-xs text-[#5A4E6D]\">Community care visits with verified evidence.</p></a><a class=\"rounded-2xl border border-[#EADFD2] bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-[#D9B27C]\" href=\"/os/initiative/syn-init-marketlink-klerksdorp\"><p class=\"text-sm font-bold text-[#5B2A86]\">Market Link</p><p class=\"mt-1 text-xs text-[#5A4E6D]\">Demand aggregation for local repair and trade.</p></a></div></section><section class=\"mt-12\"><h2 class=\"text-sm font-bold uppercase tracking-[0.22em] text-[#8B7FA3]\">National statements — evidence-linked</h2><div class=\"mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2\"><div class=\"rounded-2xl border p-5 border-[#EADFD2] bg-white shadow-sm\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm font-medium leading-relaxed text-[#241A33]\">The network is moving: 3 initiatives are accelerating and 1 is stalled.</p><span class=\"shrink-0 rounded-full border px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide border-[#9DC9B4] text-[#2F7D5C]\">Evidence-linked</span></div><p class=\"mt-3 text-xs text-[#5A4E6D]\"><span class=\"font-semibold text-[#5B2A86]\">Capability:</span> <!-- -->Operating rhythm is real but uneven — intervention quality is the constraint.</p><div class=\"mt-2\"><span class=\"flex flex-wrap gap-1\"><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/mission/syn-work-102\">syn-work-102</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/mission/syn-work-601\">syn-work-601</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/mission/syn-work-502\">syn-work-502</a></span></div><p class=\"mt-3 text-xs text-[#5A4E6D]\"><span class=\"font-semibold\">Next:</span> <!-- -->Hold a national intervention review on the 4 at-risk initiatives<!-- --> · <span class=\"font-semibold\">Owner:</span> <!-- -->national lead<!-- --> · <span class=\"font-semibold\">Review:</span> <!-- -->next national heartbeat</p></div><div class=\"rounded-2xl border p-5 border-[#EADFD2] bg-white shadow-sm\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm font-medium leading-relaxed text-[#241A33]\">Capacity gaps are the dominant constraint: verified supply trails demand in 4 of 6 initiatives.</p><span class=\"shrink-0 rounded-full border px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide border-[#9DC9B4] text-[#2F7D5C]\">Evidence-linked</span></div><p class=\"mt-3 text-xs text-[#5A4E6D]\"><span class=\"font-semibold text-[#5B2A86]\">Capability:</span> <!-- -->Verification capacity — not demand generation — limits the flywheel.</p><div class=\"mt-2\"><span class=\"flex flex-wrap gap-1\"><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/town/klerksdorp\">syn-signal-201</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/town/klerksdorp\">syn-signal-601</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/town/klerksdorp\">syn-signal-801</a></span></div><p class=\"mt-3 text-xs text-[#5A4E6D]\"><span class=\"font-semibold\">Next:</span> <!-- -->Fund two verification rounds (artisan + ECD operator)<!-- --> · <span class=\"font-semibold\">Owner:</span> <!-- -->national capacity desk<!-- --> · <span class=\"font-semibold\">Review:</span> <!-- -->after verification round 1 completes</p></div><div class=\"rounded-2xl border p-5 border-[#EADFD2] bg-white shadow-sm\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm font-medium leading-relaxed text-[#241A33]\">Proof discipline is uneven: Care Collective paid out on 2 of 9 proofs.</p><span class=\"shrink-0 rounded-full border px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide border-[#9DC9B4] text-[#2F7D5C]\">Evidence-linked</span></div><p class=\"mt-3 text-xs text-[#5A4E6D]\"><span class=\"font-semibold text-[#5B2A86]\">Capability:</span> <!-- -->Payment without proof breaks the trust model.</p><div class=\"mt-2\"><span class=\"flex flex-wrap gap-1\"><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/mission/syn-work-701\">syn-work-701</a><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/proof/syn-proof-710\">syn-proof-710</a></span></div><p class=\"mt-3 text-xs text-[#5A4E6D]\"><span class=\"font-semibold\">Next:</span> <!-- -->Run a proof-recovery mission before the next stipend round<!-- --> · <span class=\"font-semibold\">Owner:</span> <!-- -->Bushbuckridge coordinator<!-- --> · <span class=\"font-semibold\">Review:</span> <!-- -->before stipend round 2</p></div><div class=\"rounded-2xl border p-5 border-[#E8B4B0] bg-[#FDF1F0] shadow-sm\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm font-medium leading-relaxed text-[#241A33]\">Cross-town opportunity claims are not yet tested. Missing: a completed cross-town pilot with outcome proof. How to collect: run the bounded Klerksdorp↔Senekal pilot mission and capture outcome proof.</p><span class=\"shrink-0 rounded-full border px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide border-[#D98C87] text-[#A63B33]\">Insufficient Evidence</span></div><div class=\"mt-2\"><span class=\"flex flex-wrap gap-1\"><a class=\"rounded-full border border-[#E7C9A0] bg-[#FDF3E3] px-2 py-0.5 font-mono text-[10px] text-[#8A5410] hover:bg-[#F8E7CC]\" href=\"/os/town/klerksdorp\">syn-signal-801</a></span></div></div></div></section><section class=\"mt-10 rounded-2xl border border-[#D9C7EA] bg-gradient-to-br from-[#F7F1FB] to-white p-6 shadow-sm\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><h2 class=\"text-lg font-bold text-[#5B2A86]\">CHIEF OF STAFF</h2><p class=\"text-xs italic text-[#8B7FA3]\">National scope · five modes over the same evidence</p></div><div class=\"mt-4 flex flex-wrap gap-2\" role=\"tablist\" aria-label=\"Chief of Staff modes\"><button role=\"tab\" aria-selected=\"true\" class=\"rounded-full border px-3.5 py-1.5 text-xs font-semibold transition border-[#5B2A86] bg-[#5B2A86] text-white\">OBSERVE</button><button role=\"tab\" aria-selected=\"false\" class=\"rounded-full border px-3.5 py-1.5 text-xs font-semibold transition border-[#D9C7EA] bg-white text-[#5B2A86] hover:bg-[#F3EBFA]\">EXPLAIN</button><button role=\"tab\" aria-selected=\"false\" class=\"rounded-full border px-3.5 py-1.5 text-xs font-semibold transition border-[#D9C7EA] bg-white text-[#5B2A86] hover:bg-[#F3EBFA]\">CHALLENGE</button><button role=\"tab\" aria-selected=\"false\" class=\"rounded-full border px-3.5 py-1.5 text-xs font-semibold transition border-[#D9C7EA] bg-white text-[#5B2A86] hover:bg-[#F3EBFA]\">COACH</button><button role=\"tab\" aria-selected=\"false\" class=\"rounded-full border px-3.5 py-1.5 text-xs font-semibold transition border-[#D9C7EA] bg-white text-[#5B2A86] hover:bg-[#F3EBFA]\">ACT</button></div><p class=\"mt-2 text-xs italic text-[#8B7FA3]\">What is happening?</p><div class=\"mt-4 space-y-3\"><p class=\"rounded-xl border border-[#EADFD2] bg-white p-4 text-sm leading-relaxed text-[#241A33]\">The network is moving: 3 initiatives are accelerating and 1 is stalled.</p><p class=\"rounded-xl border border-[#EADFD2] bg-white p-4 text-sm leading-relaxed text-[#241A33]\">Capacity gaps are the dominant constraint: verified supply trails demand in 4 of 6 initiatives.</p><p class=\"rounded-xl border border-[#EADFD2] bg-white p-4 text-sm leading-relaxed text-[#241A33]\">Proof discipline is uneven: Care Collective paid out on 2 of 9 proofs.</p><p class=\"rounded-xl border border-[#EADFD2] bg-white p-4 text-sm leading-relaxed text-[#241A33]\">INSUFFICIENT EVIDENCE</p></div></section></div><!--$--><!--/$--></main><div class=\"mx-auto max-w-6xl px-6 pb-12\"><footer class=\"mt-16 border-t border-[#EADFD2] pt-6 text-xs text-[#8B7FA3]\"><p class=\"font-semibold text-[#5A4E6D]\">UBUNTU TOWN OS · Experience 001</p><p class=\"mt-1 max-w-3xl leading-relaxed\">Build the person. Build the initiative. Build the town. Every claim links to evidence; where evidence is missing the system says so. Consequential actions are proposals only — they require human approval and are simulated in this demo. Synthetic demo data. 50 Blueprint towns · 9 provinces navigation model.</p></footer></div></div><!--$--><!--$?--><template id=\"B:0\"></template><!--/$--><section aria-label=\"Notifications alt+T\" tabindex=\"-1\" aria-live=\"polite\" aria-relevant=\"additions text\" aria-atomic=\"false\" data-react-aria-top-layer=\"true\"></section><!--/$--><script>requestAnimationFrame(function(){$RT=performance.now()});</script><script src=\"/_next/static/chunks/webpack-2c226e022979f4f0.js\" id=\"_R_\" async=\"\"></script><div hidden id=\"S:0\"><style>\n#nprogress {\n  pointer-events: none;\n}\n\n#nprogress .bar {\n  background: #6B1F66;\n\n  position: fixed;\n  z-index: 99999;\n  top: 0;\n  left: 0;\n\n  width: 100%;\n  height: 4px;\n}\n\n/* Fancy blur effect */\n#nprogress .peg {\n  display: block;\n  position: absolute;\n  right: 0px;\n  width: 100px;\n  height: 100%;\n  box-shadow: 0 0 10px #6B1F66, 0 0 5px #6B1F66;\n  opacity: 1.0;\n\n  -webkit-transform: rotate(3deg) translate(0px, -4px);\n      -ms-transform: rotate(3deg) translate(0px, -4px);\n          transform: rotate(3deg) translate(0px, -4px);\n}\n\n/* Remove these to get rid of the spinner */\n#nprogress .spinner {\n  display: block;\n  position: fixed;\n  z-index: 1031;\n  top: 15px;\n  bottom: auto;\n  right: 15px;\n  left: auto;\n}\n\n#nprogress .spinner-icon {\n  width: 18px;\n  height: 18px;\n  box-sizing: border-box;\n\n  border: solid 2px transparent;\n  border-top-color: #6B1F66;\n  border-left-color: #6B1F66;\n  border-radius: 50%;\n\n  -webkit-animation: nprogress-spinner 400ms linear infinite;\n          animation: nprogress-spinner 400ms linear infinite;\n}\n\n.nprogress-c