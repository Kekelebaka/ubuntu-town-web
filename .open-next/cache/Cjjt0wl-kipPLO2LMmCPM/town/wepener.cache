\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-ladybrand\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"inside_town\\\"}}],\\\"businesses\\\":[{\\\"slug\\\":\\\"ladybrand\\\",\\\"name\\\":\\\"Ladybrand Farm Stall\\\",\\\"category\\\":\\\"food\\\",\\\"is_verified\\\":false,\\\"id\\\":\\\"seed-ladybrand-biz\\\",\\\"town_id\\\":null}],\\\"cv_count\\\":1},{\\\"slug\\\":\\\"ficksburg\\\",\\\"name\\\":\\\"Ficksburg\\\",\\\"region\\\":\\\"Setsoto · cherry capital\\\",\\\"district\\\":\\\"Thabo Mofutsanyana\\\",\\\"status\\\":\\\"building\\\",\\\"render_pct\\\":25,\\\"opportunity_potential\\\":54,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"assigned\\\",\\\"route\\\":\\\"/town/ficksburg\\\",\\\"illustrative\\\":false,\\\"coordinator_name\\\":\\\"Magauta Mapheleba\\\",\\\"youth_mapped\\\":0,\\\"active_signals\\\":0,\\\"open_opportunities\\\":0,\\\"lat\\\":-28.8689,\\\"lng\\\":27.8825,\\\"description\\\":\\\"Ficksburg is the self-proclaimed Cherry Capital of South Africa, hosting the annual Cherry Festival each November when the orchards burst into bloom. The town's Masermeng Cultural Village offers authentic Basotho heritage experiences, while the surrounding farmlands produce some of the province's finest livestock.\\\",\\\"population_estimate\\\":12000,\\\"archetype\\\":\\\"agricultural_town\\\",\\\"opportunities\\\":[{\\\"id\\\":\\\"opp-fram-ficksburg\\\",\\\"title\\\":\\\"FrameSouth — Town Photographer / Visual Proof Creator\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-ficksburg\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"framesouth\\\"}},{\\\"id\\\":\\\"opp-fixe-ficksburg-2\\\",\\\"title\\\":\\\"FixEasy24 — Verified Service Provider Registration\\\",\\\"type\\\":\\\"opportunity\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-ficksburg\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"fixeasy24\\\"}},{\\\"id\\\":\\\"opp-kasi-ficksburg-