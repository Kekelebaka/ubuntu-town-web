tail\\\",\\\"is_verified\\\":true,\\\"town_id\\\":\\\"town-ct\\\"}],\\\"events\\\":[{\\\"id\\\":\\\"evt-ct-1\\\",\\\"title\\\":\\\"Cape Town Youth Skills Fair\\\",\\\"description\\\":\\\"Free skills fair with 20+ exhibitors.\\\",\\\"event_date\\\":\\\"2026-07-22\\\",\\\"town_id\\\":\\\"town-ct\\\"},{\\\"slug\\\":\\\"cape-town\\\",\\\"title\\\":\\\"Cape Town Youth Skills Fair\\\",\\\"description\\\":\\\"Free skills fair with 20+ exhibitors and training providers\\\",\\\"event_date\\\":\\\"2026-07-22\\\",\\\"id\\\":\\\"seed-cape-town-evt\\\",\\\"town_id\\\":null}],\\\"access_points\\\":[{\\\"id\\\":\\\"ap-ct-1\\\",\\\"name\\\":\\\"Khayelitsha Public Library\\\",\\\"category\\\":\\\"library\\\",\\\"is_verified\\\":true,\\\"town_id\\\":\\\"town-ct\\\"}],\\\"services\\\":[{\\\"title\\\":\\\"Cape Peninsula TVET — business programmes\\\",\\\"description\\\":\\\"Business studies, IT, and hospitality. Campuses across Cape Town.\\\",\\\"price_range\\\":\\\"R8,000 - R20,000/year\\\",\\\"category\\\":\\\"education\\\"},{\\\"title\\\":\\\"MyCiTi Bus — central line\\\",\\\"description\\\":\\\"Integrated rapid transit system connecting CBD, suburbs, and airport.\\\",\\\"price_range\\\":\\\"R7 - R50\\\",\\\"category\\\":\\\"transport\\\"},{\\\"title\\\":\\\"Khayelitsha Community Health Centre\\\",\\\"description\\\":\\\"Primary healthcare services, HIV/TB treatment, maternal health.\\\",\\\"price_range\\\":\\\"Free\\\",\\\"category\\\":\\\"healthcare\\\"}]},{\\\"slug\\\":\\\"plettenberg-bay\\\",\\\"name\\\":\\\"Plettenberg Bay\\\",\\\"region\\\":\\\"coastal town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-34.052,\\\"lng\\\":23.3715,\\\"description\\\":\\\"A playground of natural beauty on the Garden Route, Plett offers pristine beaches, whale watching, and the ancient Robberg Nature Reserve peninsula. The town blends eco-tourism with a relaxed coastal lifestyle.\\\",\\\"population_estimate\\\":32000,\\\"archetype\\\":\\\"coastal_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/plettenberg-bay\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"cango-caves\\\",\\\"name\\\":\\\"Cango Caves\\\",\\\"region\\\":\\\"natural wonder\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-33.3869,\\\"lng\\\":22.2064,\\\"description\\\":\\\"Near the ostrich capital of Oudtshoorn, the Cango Caves are one of Africa's greatest natural wonders — a 20-million-year-old limestone system with chambers that can hold a cathedral.\\\",\\\"population_estimate\\\":500,\\\"archetype\\\":\\\"natural_wonder\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/cango-caves\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"cederberg\\\",\\\"name\\\":\\\"Cederberg\\\",\\\"region\\\":\\\"wilderness\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-32.35,\\\"lng\\\":19.1,\\\"description\\\":\\\"The Cederberg Wilderness Area is a landscape of dramatic rock formations, ancient San rock art, and endemic plant species found nowhere else on earth. This is where the Wild Coast meets the wilderness.\\\",\\\"population_estimate\\\":3000,\\\"archetype\\\":\\\"wilderness\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/cederberg\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"hopefield\\\",\\\"name\\\":\\\"Hopefield\\\",\\\"region\\\":\\\"west coast\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-33.0667,\\\"lng\\\":18.35,\\\"description\\\":\\\"A small West Coast town that explodes into colour during spring flower season, Hopefield is the gateway to the West Coast's wildflower displays and the nearby West Coast National Park.\\\",\\\"population_estimate\\\":4500,\\\"archetype\\\":\\\"west_coast\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/hopefield\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"citrusdal\\\",\\\"name\\\":\\\"Citrusdal\\\",\\\"region\\\":\\\"cederberg\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-32.5833,\\\"lng\\\":19.0167,\\\"description\\\":\\\"Nestled in the Olifants River Valley at the foot of the Cederberg, Citrusdal is South Africa's citrus capital — the orchards that fill supermarket shelves across the country start here.\\\",\\\"population_estimate\\\":6000,\\\"archetype\\\":\\\"cederberg\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/citrusdal\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"porterville\\\",\\\"name\\\":\\\"Porterville\\\",\\\"region\\\":\\\"west coast\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-33.0167,\\\"lng\\\":18.9833,\\\"description\\\":\\\"Known as the windiest town on the West Coast, Porterville has turned its relentless breeze into an asset as a world-class paragliding destination. The nearby Cederberg hikes are spectacular.\\\",\\\"population_estimate\\\":3500,\\\"archetype\\\":\\\"west_coast\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/porterville\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"langebaan\\\",\\\"name\\\":\\\"Langebaan\\\",\\\"region\\\":\\\"lagoon town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-33.0917,\\\"lng\\\":18.0333,\\\"description\\\":\\\"A laid-back lagoon town in the West Coast National Park, Langebaan offers kitesurfing, sailing, and some of the best birdwatching in the Western Cape. The spring wildflower season transforms the surrounding strandveld.\\\",\\\"population_estimate\\\":8000,\\\"archetype\\\":\\\"lagoon_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/langebaan\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"george-west\\\",\\\"name\\\":\\\"George West\\\",\\\"region\\\":\\\"farming town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-33.2333,\\\"lng\\\":19.0167,\\\"description\\\":\\\"Not to be confused with George on the Garden Route, this small Western Cape farming community serves the surrounding agricultural district. A quiet corner of the province where farming life continues.\\\",\\\"population_estimate\\\":2000,\\\"archetype\\\":\\\"farming_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/george-west\\\",\\\"illustrative\\\":true}],\\\"hero_image\\\":\\\"https://images.unsplash.com/photo-1580060839134-75a5edca2e99?w=1200\\u0026q=80\\\",\\\"description\\\":\\\"From the iconic Table Mountain to the Garden Route, the Western Cape blends world-class natural beauty with a thriving innovation economy. 17 towns from Cape Town to the Cederberg form the backbone of South Africa's tourism and tech capital.\\\",\\\"coordinators\\\":[{\\\"name\\\":\\\"Lindiwe Mthembu\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"cape-town\\\"},{\\\"name\\\":\\\"Kagiso Motaung\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"paarl\\\"},{\\\"name\\\":\\\"Karabo Letsie\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"stellenbosch\\\"},{\\\"name\\\":\\\"Anele Swarts\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"george\\\"},{\\\"name\\\":\\\"Sipho Ndlovu\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"cape-town\\\"}],\\\"featured_stories\\\":[{\\\"title\\\":\\\"From Khayelitsha to Cape Town IT\\\",\\\"content\\\":\\\"Sipho started as volunteer coordinator, now works at a tech startup.\\\",\\\"author\\\":\\\"Sipho N.\\\",\\\"town\\\":\\\"cape-town\\\"}],\\\"top_opportunities\\\":[{\\\"title\\\":\\\"NYDA National Youth Service Phase V — 100,000 Paid Opportunities\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"government\\\",\\\"town\\\":\\\"cape-town\\\"},{\\\"title\\\":\\\"Funza Lushaka Teaching Bursary 2027\\\",\\\"type\\\":\\\"training\\\",\\\"source\\\":\\\"government\\\",\\\"town\\