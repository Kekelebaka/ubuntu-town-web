_pct\\\":0,\\\"opportunity_potential\\\":48,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/knysna\\\",\\\"illustrative\\\":true,\\\"lat\\\":-34.0362,\\\"lng\\\":23.0475,\\\"description\\\":\\\"The Jewel of the Garden Route, Knysna wraps around a vast lagoon between two dramatic headlands, with indigenous forest, oyster farms, and the famous Knysna Heads creating one of South Africa's most beautiful settings.\\\",\\\"population_estimate\\\":52000,\\\"archetype\\\":\\\"garden_route\\\",\\\"businesses\\\":[{\\\"slug\\\":\\\"knysna\\\",\\\"name\\\":\\\"Knysna Heads Restaurant\\\",\\\"category\\\":\\\"food\\\",\\\"is_verified\\\":false,\\\"id\\\":\\\"seed-knysna-biz\\\",\\\"town_id\\\":null}],\\\"events\\\":[{\\\"slug\\\":\\\"knysna\\\",\\\"title\\\":\\\"Knysna Oyster Festival\\\",\\\"description\\\":\\\"Food, sport, and oysters on the Garden Route\\\",\\\"event_date\\\":\\\"2026-07-01\\\",\\\"id\\\":\\\"seed-knysna-evt\\\",\\\"town_id\\\":null}]},{\\\"slug\\\":\\\"hermanus\\\",\\\"name\\\":\\\"Hermanus\\\",\\\"region\\\":\\\"Overberg · whale coast\\\",\\\"district\\\":\\\"Overberg\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":46,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/hermanus\\\",\\\"illustrative\\\":true,\\\"lat\\\":-34.4172,\\\"lng\\\":19.2345,\\\"description\\\":\\\"South Africa's premier whale-watching destination, Hermanus hosts the annual Whale Festival when southern right whales arrive in Walker Bay. The Hemel-en-Aarde Valley behind the town produces world-class Pinot Noir and Chardonnay.\\\",\\\"population_estimate\\\":12000,\\\"archetype\\\":\\\"coastal_town\\\",\\\"businesses\\\":[{\\\"slug\\\":\\\"hermanus\\\",\\\"name\\\":\\\"Hermanus Whale Watching\\\",\\\"category\\\":\\\"tourism\\\",\\\"is_verified\\\":false,\\\"id\\\":\\\"seed-hermanus-biz\\\",\\\"town_id\\\":null}],\\\"events\\\":[{\\\"slug\\\":\\\"hermanus\\\",\\\"titl