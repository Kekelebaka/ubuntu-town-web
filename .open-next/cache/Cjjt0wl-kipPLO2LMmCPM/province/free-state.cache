,\"cv_count\":1},{\"slug\":\"botshabelo\",\"name\":\"Botshabelo\",\"region\":\"Mantsopa · township\",\"district\":\"Thabo Mofutsanyana\",\"status\":\"ghost\",\"render_pct\":25,\"opportunity_potential\":45,\"heritage\":false,\"coordinator_status\":\"assigned\",\"route\":\"/town/botshabelo\",\"illustrative\":true,\"coordinator_name\":\"Xoliswa Portia Xhalabile\",\"youth_mapped\":0,\"active_signals\":0,\"open_opportunities\":0,\"lat\":-29.2167,\"lng\":26.7333,\"description\":\"Large township south of Bloemfontein with over 300,000 residents. A major residential area with a growing economy.\",\"opportunities\":[{\"id\":\"opp-bunt-botshabelo\",\"title\":\"BuntuBar — Mobile Bar Event Workshop\",\"type\":\"training\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-botshabelo\",\"metadata\":{\"ecosystem\":\"buntubar\"}},{\"id\":\"opp-aica-botshabelo-2\",\"title\":\"AI Café — Digital Access Point / CV Service Agent\",\"type\":\"volunteer\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-botshabelo\",\"metadata\":{\"ecosystem\":\"aicafe\"}},{\"id\":\"opp-ubun-botshabelo-3\",\"title\":\"Ubuntu Academy — Skills & Job Readiness Workshop\",\"type\":\"training\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-botshabelo\",\"metadata\":{\"ecosystem\":\"ubuntu_academy\"}}],\"cv_count\":1},{\"slug\":\"clocolan\",\"name\":\"Clocolan\",\"region\":\"Setsoto · grain & sandstone\",\"district\":\"Thabo Mofutsanyana\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":28,\"heritage\":false,\"coordinator_status\":\"recruiting\",\"route\":\"/town/clocolan\",\"illustrative\":true,\"lat\":-28.9,\"lng\":27.5667,\"description\":\"Small farming town known for sandstone geology and grain production in the eastern Free State.\"},{\"slug\":\"fouriesburg\",\"name\":\"Fouriesburg\",\"region\":\"Dihlabeng · Brandwater basin\",\"district\":\"Thabo Mofutsanyana\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"heritage\":true,\"coordinator_status\":\"recruiting\",\"route\":\"/town/fouriesburg\",\"illustrative\":true,\"lat\":-28.6167,\"lng\":28.25,\"description\":\"Perched in the foothills of the Maloti Mountains at the gateway to Lesotho, Fouriesburg is a peaceful farming town where the annual Fouriesburg Arts Festival celebrates local talent. The nearby Sani Pass offers one of South Africa's most thrilling mountain drives into the Kingdom in the Sky.\",\"population_estimate\":2500,\"archetype\":\"heritage_town\"},{\"slug\":\"reitz\",\"name\":\"Reitz\",\"region\":\"Nketoana · maize belt\",\"district\":\"Thabo Mofutsanyana\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":26,\"heritage\":false,\"coordinator_status\":\"recruiting\",\"route\":\"/town/reitz\",\"illustrative\":true,\"lat\":-27.8,\"lng\":28.4333,\"description\":\"A small but determined farming town in the northern Free State, Reitz is the centre of a rich agricultural district producing maize, sunflowers, and livestock. The annual Reitz Show brings the whole community together to celebrate rural life.\",\"population_estimate\":3500,\"archetype\":\"farming_town\"},{\"slug\":\"marquard\",\"name\":\"Marquard\",\"region\":\"Setsoto · grain\",\"district\":\"Thabo Mofutsanyana\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":22,\"heritage\":false,\"coordinator_status\":\"recruiting\",\"route\":\"/town/marquard\",\"illustrative\":true,\"lat\":-28.0667,\"lng\":27.8833,\"description\":\"Quiet grain farming village surrounded by wheat and maize fields. A tight-knit rural community.\"},{\"slug\":\"hobhouse\",\"name\":\"Hobhouse\",\"region\":\"Mantsopa · border farming\",\"district\":\"Thabo Mofutsanyana\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":20,\"heritage\":false,\"coordinator_status\":\"recruiting\",\"route\":\"/town/hobhouse\",\"illustrative\":true,\"lat\":-29.5333,\"lng\":26.95,\"description\":\"Border farming village near Lesotho, where generations have worked the land in the southern Free State.\"},{\"slug\":\"tweespruit\",\"name\":\"Tweespruit\",\"region\":\"Mantsopa · N8 corridor\",\"district\":\"Thabo Mofutsanyana\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":24,\"heritage\":false,\"coordinator_status\":\"recruiting\",\"route\":\"/town/tweespruit\",\"illustrative\":true,\"lat\":-29.2333,\"lng\":27.1833,\"description\":\"Small town on the N8 between Bloemfontein and Ladybrand, surrounded by agricultural land.\"},{\"slug\":\"zastron\",\"name\":\"Zastron\",\"region\":\"Mohokare · Maluti foothills\",\"district\":\"Xhariep\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":25,\"heritage\":true,\"coordinator_status\":\"recruiting\",\"route\":\"/town/zastron\",\"illustrative\":true,\"lat\":-30.3,\"lng\":27.0333,\"description\":\"Historic town at the Maluti foothills, known for the Battle of Mabolidrift and Karoo landscape.\"},{\"slug\":\"wepener\",\"name\":\"Wepener\",\"region\":\"Mohokare · Caledon river\",\"district\":\"Xhariep\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":18,\"heritage\":false,\"coordinator_status\":\"recruiting\",\"route\":\"/town/wepener\",\"illustrative\":true,\"lat\":-29.75,\"lng\":27.0333,\"description\":\"Right on the border with Lesotho at the Caledon River, Wepener is a small trading town that serves the surrounding farming community and the mountain kingdom next door. The annual agricultural show draws visitors from both sides of the border.\",\"population_estimate\":2000,\"archetype\":\"border_town\"},{\"slug\":\"smithfield\",\"name\":\"Smithfield\",\"region\":\"Mohokare · historic Karoo\",\"district\":\"Xhariep\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":22,\"heritage\":true,\"coordinator_status\":\"recruiting\",\"route\":\"/town/smithfield\",\"illustrative\":true,\"lat\":-30.2167,\"lng\":25.55,\"description\":\"Smithfield holds a special place in South African history as the birthplace of Oliver Reginald Tambo, ANC president and anti-apartheid leader. This small southern Free State town is working to preserve and celebrate this heritage.\",\"population_estimate\":1200,\"archetype\":\"heritage_town\"},{\"slug\":\"rosendal\",\"name\":\"Rosendal\",\"region\":\"Dihlabeng · arts hamlet\",\"district\":\"Thabo Mofutsanyana\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":16,\"heritage\":true,\"coordinator_status\":\"recruiting\",\"route\":\"/town/rosendal\",\"illustrative\":true,\"lat\":-28.5333,\"lng\":27.9833,\"description\":\"Arts hamlet known for galleries, craft markets, and stunning Maluti Mountain views.\"},{\"slug\":\"paul-roux\",\"name\":\"Paul Roux\",\"region\":\"Dihlabeng · sandstone village\",\"district\":\"Thabo Mofutsanyana\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":15,\"heritage\":false,\"coordinator_status\":\"recruiting\",\"route\":\"/town/paul-roux\",\"illustrative\":true,\"lat\":-28.3,\"lng\":27.95,\"description\":\"Small sandstone village in the Dihlabeng municipality, surrounded by farmlands.\"},{\"slug\":\"bloemfontein\",\"name\":\"Bloemfontein\",\"region\":\"\",\"status\":\"building\",\"render_pct\":55,\"opportunity_potential\":75,\"coordinator_status\":\"assigned\",\"route\":\"/town/bloemfontein\",\"illustrative\":false,\"coordinator_name\":\"Tshabalala Katleho Alfred\",\"youth_mapped\":145,\"active_signals\":1,\"open_opportunities\":3,\"lat\":-29.0852,\"lng\":26.1596,\"description\":\"The judicial capital of South Africa and City of Roses, Bloemfontein sits at the heart of the Free State where the National Museum, Naval Hill, and the University of the Free State anchor a city that blends heritage with youthful energy. From the annual spring flower displays to the vibrant twin cities of Mangaung, this is where South Africa's legal and academic traditions meet everyday South African life.\",\"population_estimate\":256000,\"archetype\":\"provincial_capital\",\"opportunities\":[{\"id\":\"opp-nyda-bloem\",\"title\":\"NYDA National Youth Service Phase V — 100,000 Paid Opportunities\",\"type\":\"volunteer\",\"source\":\"government\",\"deadline_date\":\"2026-09-30\",\"town_id\":\"town-bloem\",\"metadata\":{\"national\":true}},{\"id\":\"opp-fix-bloem\",\"title\":\"FixEasy24 — Verified Service Providers Needed\",\"type\":\"volunteer\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-bloem\",\"metadata\":{\"ecosystem\":\"fixeasy24\"}},{\"id\":\"opp-frame-bloem\",\"title\":\"FrameSouth — Town Photographer & Visual Partner\",\"type\":\"internship\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-bloem\",\"metadata\":{\"ecosystem\":\"framesouth\"}},{\"id\":\"opp-acad-bloem\",\"title\":\"Ubuntu Academy — Business Profile & Marketing Workshop\",\"type\":\"training\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-bloem\",\"metadata\":{\"ecosystem\":\"ubuntu_academy\"}},{\"id\":\"opp-inside-bloem\",\"title\":\"Inside.Town — Podcast Host & Town Voice\",\"type\":\"volunteer\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-bloem\",\"metadata\":{\"ecosystem\":\"inside_town\"}}],\"signals\":[{\"id\":\"sig-bloem-1\",\"title\":\"Boil water notice — Mangaung\",\"category\":\"infrastructure\",\"status\":\"pending\",\"town_id\":\"town-bloem\"}],\"businesses\":[{\"id\":\"biz-bloem-1\",\"name\":\"Botshabelo Community Kitchen\",\"category\":\"retail\",\"is_verified\":true,\"town_id\":\"town-bloem\"}],\"events\":[{\"id\":\"evt-bloem-1\",\"title\":\"Mangaung Water Crisis Town Hall\",\"description\":\"Community meeting on water infrastructure.\",\"event_date\":\"2026-07-08\",\"town_id\":\"town-bloem\"},{\"slug\":\"bloemfontein\",\"title\":\"MACUFE Festival\",\"description\":\"Mangaung African Cultural Festival — music, dance, art, and theatre\",\"event_date\":\"2026-10-01\",\"id\":\"seed-bloemfontein-evt\",\"town_id\":null}],\"access_points\":[{\"id\":\"ap-bloem-1\",\"name\":\"Botshabelo Community Centre\",\"category\":\"community_centre\",\"is_verified\":true,\"town_id\":\"town-bloem\"}],\"services\":[{\"title\":\"Motheo TVET College — NATED programmes\",\"description\":\"Engineering, business, and utility studies. Registration open.\",\"price_range\":\"R5,000 - R15,000/year\",\"category\":\"education\"},{\"title\":\"National Museum — school tours\",\"description\":\"Free educational tours for schools. Natural history and cultural exhibits.\",\"price_range\":\"Free\",\"category\":\"tourism\"},{\"title\":\"Mangaung Water & Sanitation\",\"description\":\"Municipal water and sanitation services. Report faults online.\",\"price_range\":\"Municipal rates\",\"category\":\"utility\"}],\"cv_count\":3},{\"slug\":\"welkom\",\"name\":\"Welkom\",\"region\":\"\",\"status\":\"building\",\"render_pct\":35,\"opportunity_potential\":45,\"coordinator_status\":\"assigned\",\"route\":\"/town/welkom\",\"illustrative\":false,\"coordinator_name\":\"Dineo Mosia\",\"youth_mapped\":98,\"active_signals\":0,\"open_opportunities\":2,\"lat\":-27.975,\"lng\":26.7333,\"description\":\"Gold mining city in the Lejweleputswa district, home to gold mines and the Goldfields Mall.\",\"opportunities\":[{\"id\":\"opp-fami-welk\",\"title\":\"FamilyHouse — Home Hospitality Host Registration\",\"type\":\"opportunity\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-welk\",\"metadata\":{\"ecosystem\":\"familyhouse\"}},{\"id\":\"opp-ecoc-welk-2\",\"title\":\"EcoChar — 5-Day Charcoal Production Training\",\"type\":\"training\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-welk\",\"metadata\":{\"ecosystem\":\"ecochar\"}},{\"id\":\"opp-bunt-welk-3\",\"title\":\"BuntuBar — Mobile Bar Event Workshop\",\"type\":\"training\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-welk\",\"metadata\":{\"ecosystem\":\"buntubar\"}}]},{\"slug\":\"kroonstad\",\"name\":\"Kroonstad\",\"region\":\"\",\"status\":\"building\",\"render_pct\":9,\"opportunity_potential\":30,\"coordinator_status\":\"assigned\",\"route\":\"/town/kroonstad\",\"illustrative\":false,\"coordinator_name\":\"Mandla Sithole\",\"youth_mapped\":35,\"active_signals\":0,\"open_opportunities\":1,\"lat\":-27.65,\"lng\":27.2333,\"description\":\"A major agricultural centre on the N1 highway, Kroonstad serves the surrounding grain and livestock farms while offering visitors a slice of Free State town life. The Vaal River nearby provides fishing and watersports, and the town's Dutch Reformed churches are architectural landmarks.\",\"population_estimate\":25000,\"archetype\":\"commercial_town\",\"opportunities\":[{\"id\":\"opp-coord-kroon\",\"title\":\"Ubuntu Town Coordinator — Kroonstad\",\"type\":\"volunteer\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-kroon\",\"metadata\":{\"ecosystem\":\"coordinator\"}}]},{\"slug\":\"lindley\",\"name\":\"Lindley\",\"region\":\"farming town\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-27.8833,\"lng\":27.9,\"description\":\"Lindley is a quiet Free State farming community on the banks of the Vals River, where life moves at the pace of the seasons. The surrounding grain fields and livestock farms are the heartbeat of this close-knit town.\",\"population_estimate\":2800,\"archetype\":\"farming_town\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/lindley\",\"illustrative\":true},{\"slug\":\"petrusburg\",\"name\":\"Petrusburg\",\"region\":\"farming town\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-29.1333,\"lng\":25.75,\"description\":\"A small agricultural town between Bloemfontein and Kimberley, Petrusburg is a crossroads community where Free State farming meets Northern Cape frontier spirit. The town's churches and school are community anchors.\",\"population_estimate\":2200,\"archetype\":\"farming_town\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/petrusburg\",\"illustrative\":true},{\"slug\":\"jagersfontein\",\"name\":\"Jagersfontein\",\"region\":\"mining heritage\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-29.7833,\"lng\":25.4333,\"description\":\"One of the oldest diamond towns in South Africa, Jagersfontein was where diamonds were first discovered in the 1870s — even before Kimberley. The historic town square and mining heritage tell the story of the diamond rush that changed the world.\",\"population_estimate\":1800,\"archetype\":\"mining_heritage\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/jagersfontein\",\"illustrative\":true},{\"slug\":\"villiers\",\"name\":\"Villiers\",\"region\":\"farming town\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-27.1167,\"lng\":28.55,\"description\":\"A small town along the N3 between Johannesburg and Durban, Villiers is a Free State crossroads where travellers stop and locals carry on with farming life. The surrounding landscape is classic highveld — rolling grass and big skies.\",\"population_estimate\":1500,\"archetype\":\"farming_town\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/villiers\",\"illustrative\":true},{\"slug\":\"heidelberg-fs\",\"name\":\"Heidelberg FS\",\"region\":\"farming town\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-29.5167,\"lng\":26.65,\"description\":\"A small farming community on the banks of the Riet River, Heidelberg in the Free State is where generations of farming families have built a life on the land. The town's churches and school are the pillars of the community.\",\"population_estimate\":2000,\"archetype\":\"farming_town\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/heidelberg-fs\",\"illustrative\":true},{\"slug\":\"staasiens\",\"name\":\"Staasiens\",\"region\":\"farming town\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-29.3,\"lng\":25.9,\"description\":\"Deep in the Free State farmlands, Staasiens represents the heartland of South African agriculture — wide fields, hardworking communities, and the quiet dignity of rural life.\",\"population_estimate\":800,\"archetype\":\"farming_town\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/staasiens\",\"illustrative\":true},{\"slug\":\"golden-gate\",\"name\":\"Golden Gate\",\"region\":\"nature reserve\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-28.5333,\"lng\":28.55,\"description\":\"The Golden Gate Highlands National Park is a landscape of dramatic sandstone cliffs, high-altitude grasslands, and the Basotho Cultural Village. This is where Lesotho's mountains meet the Free State plains in a blaze of golden light.\",\"population_estimate\":500,\"archetype\":\"nature_reserve\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/golden-gate\",\"illustrative\":true},{\"slug\":\"philippolis\",\"name\":\"Philippolis\",\"region\":\"heritage town\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-30.0833,\"lng\":25.2667,\"description\":\"The oldest town in the Free State, Philippolis was founded by missionaries in 1822 and was once home to the famous Adam Kok III. The historic thatched-roof buildings and mission station tell a story of resilience and cultural exchange.\",\"population_estimate\":1200,\"archetype\":\"heritage_town\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/philippolis\",\"illustrative\":true},{\"slug\":\"trompsburg\",\"name\":\"Trompsburg\",\"region\":\"farming town\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-30.0333,\"lng\":25.7833,\"description\":\"A quiet farming town in the southern Free State near the Lesotho border, Trompsburg is surrounded by sheep and cattle farms in the rolling grasslands. The town's annual agricultural show is the highlight of the social calendar.\",\"population_estimate\":1500,\"archetype\":\"farming_town\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/trompsburg\",\"illustrative\":true},{\"slug\":\"springfontein\",\"name\":\"Springfontein\",\"region\":\"heritage town\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-30.2833,\"lng\":25.7,\"description\":\"On the historic railway line between Bloemfontein and the Cape, Springfontein is a small farming community with a proud Boer War heritage. The surrounding veld is classic Free State — wide skies, golden grass, and endless horizons.\",\"population_estimate\":1000,\"archetype\":\"heritage_town\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/springfontein\",\"illustrative\":true},{\"slug\":\"thaba-nchu\",\"name\":\"Thaba Nchu\",\"region\":\"cultural town\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-29.2167,\"lng\":26.85,\"description\":\"Thaba Nchu means 'black mountain' in Sesotho and is the historical home of the Barolong people in the Free State. The town's Basotho heritage, annual cultural events, and community spirit make it a vital part of the province's identity.\",\"population_estimate\":15000,\"archetype\":\"cultural_town\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/thaba-nchu\",\"illustrative\":true},{\"slug\":\"mangaung\",\"name\":\"Mangaung\",\"region\":\"metropolitan\",\"status\":\"ghost\",\"render_pct\":0,\"opportunity_potential\":30,\"lat\":-29.0852,\"lng\":26.1596,\"description\":\"The metropolitan municipality that includes Bloemfontein, Mangaung is where urban energy meets Free State soul. The University of the Free State brings youth culture and innovation, while the annual MACUFE festival is one of South Africa's premier arts events.\",\"population_estimate\":256000,\"archetype\":\"metropolitan\",\"coordinator_status\":\"recruiting\",\"route\":\"/town/mangaung\",\"illustrative\":true}],\"hero_image\":\"https://images.unsplash.com/photo-1590001155093-a3c66ab0c3ff?w=1200&q=80\",\"description\":\"The heartland of South Africa, where golden grasslands stretch to the horizon and sandstone towns hold centuries of stories. Free State is home to 22 towns across rolling farmlands, the Maluti Mountains, and the Golden Gate Highlands.\",\"coordinators\":[{\"name\":\"Dineo Mosia\",\"status\":\"active\",\"town\":\"welkom\"},{\"name\":\"Palesa Judith Makhetha\",\"status\":\"active\",\"town\":\"senekal\"},{\"name\":\"Magauta Mapheleba\",\"status\":\"active\",\"town\":\"ladybrand\"},{\"name\":\"Sinoto Selepe\",\"status\":\"active\",\"town\":\"bethlehem\"},{\"name\":\"Xoliswa Portia Xhalabile\",\"status\":\"active\",\"town\":\"botshabelo\"},{\"name\":\"Magauta Mapheleba\",\"status\":\"active\",\"town\":\"ficksburg\"},{\"name\":\"Tshabalala Katleho Alfred\",\"status\":\"active\",\"town\":\"bloemfontein\"},{\"name\":\"Sipho Nkosi\",\"status\":\"active\",\"town\":\"harrismith\"},{\"name\":\"Mandla Sithole\",\"status\":\"active\",\"town\":\"kroonstad\"},{\"name\":\"Ayanda Radebe\",\"status\":\"active\",\"town\":\"phuthaditjhaba\"},{\"name\":\"Mpho Lekota\",\"status\":\"active\",\"town\":\"bloemfontein\"}],\"top_opportunities\":[{\"title\":\"NYDA National Youth Service Phase V — 100,000 Paid Opportunities\",\"type\":\"volunteer\",\"source\":\"government\",\"town\":\"bloemfontein\"},{\"title\":\"FixEasy24 — Verified Service Providers Needed\",\"type\":\"volunteer\",\"source\":\"ngo\",\"town\":\"bloemfontein\"},{\"title\":\"FrameSouth — Town Photographer & Visual Partner\",\"type\":\"internship\",\"source\":\"ngo\",\"town\":\"bloemfontein\"},{\"title\":\"Ubuntu Academy — Business Profile & Marketing Workshop\",\"type\":\"training\",\"source\":\"ngo\",\"town\":\"bloemfontein\"},{\"title\":\"Inside.Town — Podcast Host & Town Voice\",\"type\":\"volunteer\",\"source\":\"ngo\",\"town\":\"bloemfontein\"}]},\"lens\":\"investor\"}]\nb:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n7:null\n9:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Free State — Ubuntu Town Province | Ubuntu Town\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"The heartland of South Africa, where golden grasslands stretch to the horizon and sandstone towns hold centuries of stories. Free State is home to 22 towns acro\"}],[\"$\",\"link\",\"2\",{\"rel\":\"author\",\"href\":\"https://kekelebaka.com\"}],[\"$\",\"meta\",\"3\",{\"name\":\"author\",\"content\":\"Keke Lebaka\"}],[\"$\",\"meta\",\"4\",{\"name\":\"keywords\",\"content\":\"Ubuntu Town,South Africa,town coordinator,opportunity infrastructure,CV engine,workpacks,proof-based work,agentic economy,Ubuntu Intelligence,Kopano,ambassador network,community coordination,small towns,townships,job matching\"}],[\"$\",\"meta\",\"5\",{\"name\":\"creator\",\"content\":\"Keke Lebaka\"}],[\"$\",\"meta\",\"6\",{\"name\":\"publisher\",\"content\":\"Ubuntu Town\"}],[\"$\",\"meta\",\"7\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"8\",{\"name\":\"googlebot\",\"content\":\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\"}],[\"$\",\"link\",\"9\",{\"rel\":\"alternate\",\"type\":\"application/json\",\"href\":\"https://ubuntu-town-os-experience-001.chiefops26.workers.dev/ubuntu-town.json\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:title\",\"content\":\"Free State — Ubuntu Town\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:description\",\"content\":\"The heartland of South Africa, where golden grasslands stretch to the horizon and sandstone towns hold centuries of stories. Free State is home to 22 towns acro\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"13\",{\"name\":\"twitter:creator\",\"content\":\"@kekelebaka\"}],[\"$\",\"meta\",\"14\",{\"name\":\"twitter:title\",\"content\":\"Ubuntu Town — 1 Million CVs. 1 Million Opportunities.\"}],[\"$\",\"meta\",\"15\",{\"name\":\"twitter:description\",\"content\":\"Community opportunity infrastructure for South African towns. Connecting communities with verified opportunities, CV creation, and coordinator networks.\"}],[\"$\",\"meta\",\"16\",{\"name\":\"twitter:image\",\"content\":\