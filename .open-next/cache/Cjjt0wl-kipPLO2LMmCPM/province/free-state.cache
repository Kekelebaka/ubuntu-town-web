m\\\",\\\"is_verified\\\":false,\\\"id\\\":\\\"seed-ficksburg-biz\\\",\\\"town_id\\\":null}],\\\"events\\\":[{\\\"slug\\\":\\\"ficksburg\\\",\\\"title\\\":\\\"Cherry Festival\\\",\\\"description\\\":\\\"Annual cherry harvest celebration with tastings, music, and market stalls\\\",\\\"event_date\\\":\\\"2026-11-15\\\",\\\"id\\\":\\\"seed-ficksburg-evt\\\",\\\"town_id\\\":null}],\\\"services\\\":[{\\\"title\\\":\\\"Cherry Festival — November annually\\\",\\\"description\\\":\\\"Annual cherry harvest celebration. Tastings, music, market stalls.\\\",\\\"price_range\\\":\\\"R50 - R200\\\",\\\"category\\\":\\\"tourism\\\"},{\\\"title\\\":\\\"Masermeng Cultural Village\\\",\\\"description\\\":\\\"Authentic Basotho heritage experiences and traditional meals.\\\",\\\"price_range\\\":\\\"R100 - R300\\\",\\\"category\\\":\\\"tourism\\\"}],\\\"cv_count\\\":1},{\\\"slug\\\":\\\"clarens\\\",\\\"name\\\":\\\"Clarens\\\",\\\"region\\\":\\\"Dihlabeng · arts \\u0026 Maluti\\\",\\\"district\\\":\\\"Thabo Mofutsanyana\\\",\\\"status\\\":\\\"building\\\",\\\"render_pct\\\":30,\\\"opportunity_potential\\\":58,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"assigned\\\",\\\"route\\\":\\\"/town/clarens\\\",\\\"illustrative\\\":false,\\\"lat\\\":-28.5167,\\\"lng\\\":28.4167,\\\"description\\\":\\\"Known as the Jewel of the Free State, Clarens is an artistic village surrounded by sandstone cliffs and golden grasslands, home to dozens of galleries, craft shops, and the famous Clarens Brewery. The town attracts creatives and outdoor enthusiasts with hiking trails, fly-fishing, and the nearby Golden Gate Highlands.\\\",\\\"population_estimate\\\":5000,\\\"archetype\\\":\\\"art_village\\\",\\\"stories\\\":[{\\\"slug\\\":\\\"clarens\\\",\\\"title\\\":\\\"Art Village Rising\\\",\\\"content\\\":\\\"Clarens galleries now attract visitors from around the world. The annual Arts Festival brings thousands to our small mountain village.\\\",\\\"author_name\\\":\\\"Anna V.\\\",\\\"id\\\":\\\"seed-cla