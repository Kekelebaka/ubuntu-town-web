\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-welk\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"familyhouse\\\"}},{\\\"id\\\":\\\"opp-ecoc-welk-2\\\",\\\"title\\\":\\\"EcoChar — 5-Day Charcoal Production Training\\\",\\\"type\\\":\\\"training\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-welk\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"ecochar\\\"}},{\\\"id\\\":\\\"opp-bunt-welk-3\\\",\\\"title\\\":\\\"BuntuBar — Mobile Bar Event Workshop\\\",\\\"type\\\":\\\"training\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-welk\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"buntubar\\\"}}]},{\\\"slug\\\":\\\"kroonstad\\\",\\\"name\\\":\\\"Kroonstad\\\",\\\"region\\\":\\\"\\\",\\\"status\\\":\\\"building\\\",\\\"render_pct\\\":9,\\\"opportunity_potential\\\":30,\\\"coordinator_status\\\":\\\"assigned\\\",\\\"route\\\":\\\"/town/kroonstad\\\",\\\"illustrative\\\":false,\\\"coordinator_name\\\":\\\"Mandla Sithole\\\",\\\"youth_mapped\\\":35,\\\"active_signals\\\":0,\\\"open_opportunities\\\":1,\\\"lat\\\":-27.65,\\\"lng\\\":27.2333,\\\"description\\\":\\\"A major agricultural centre on the N1 highway, Kroonstad serves the surrounding grain and livestock farms while offering visitors a slice of Free State town life. The Vaal River nearby provides fishing and watersports, and the town's Dutch Reformed churches are architectural landmarks.\\\",\\\"population_estimate\\\":25000,\\\"archetype\\\":\\\"commercial_town\\\",\\\"opportunities\\\":[{\\\"id\\\":\\\"opp-coord-kroon\\\",\\\"title\\\":\\\"Ubuntu Town Coordinator — Kroonstad\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-kroon\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"coordinator\\\"}}]},{\\\"slug\\\":\\\"lindley\\\",\\\"name\\\":\\\"Lindley\\\",\\\"region\\\":\\\"farming town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-27.8833,\\\"lng\\\":27.9,\\\"description\\\":\\\"Lindley is a quiet Free State farming community on the banks of the Vals River, where life moves at the pace of the seasons. The surrounding grain fields and livestock farms are the heartbeat of this close-knit town.\\\",\\\"population_estimate\\\":2800,\\\"archetype\\\":\\\"farming_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/lindley\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"petrusburg\\\",\\\"name\\\":\\\"Petrusburg\\\",\\\"region\\\":\\\"farming town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-29.1333,\\\"lng\\\":25.75,\\\"description\\\":\\\"A small agricultural town between Bloemfontein and Kimberley, Petrusburg is a crossroads community where Free State farming meets Northern Cape frontier spirit. The town's churches and school are community anchors.\\\",\\\"population_estimate\\\":2200,\\\"archetype\\\":\\\"farming_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/petrusburg\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"jagersfontein\\\",\\\"name\\\":\\\"Jagersfontein\\\",\\\"region\\\":\\\"mining heritage\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-29.7833,\\\"lng\\\":25.4333,\\\"description\\\":\\\"One of the oldest diamond towns in South Africa, Jagersfontein was where diamonds were first discovered in the 1870s — even before Kimberley. The historic town square and mining heritage tell the story of the diamond rush that changed the world.\\\",\\\"population_estimate\\\":1800,\\\"archetype\\\":\\\"mining_heritage\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/jagersfontein\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"villiers\\\",\\\"name\\\":\\\"Villiers\\\",\\\"region\\\":\\\"farming town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-27.1167,\\\"lng\\\":28.55,\\\"description\\\":\\\"A small town along the N3 between Johannesburg and Durban, Villiers is a Free State crossroads where travellers stop and locals carry on with farming life. The surrounding landscape is classic highveld — rolling grass and big skies.\\\",\\\"population_estimate\\\":1500,\\\"archetype\\\":\\\"farming_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/villiers\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"heidelberg-fs\\\",\\\"name\\\":\\\"Heidelberg FS\\\",\\\"region\\\":\\\"farming town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-29.5167,\\\"lng\\\":26.65,\\\"description\\\":\\\"A small farming community on the banks of the Riet River, Heidelberg in the Free State is where generations of farming families have built a life on the land. The town's churches and school are the pillars of the community.\\\",\\\"population_estimate\\\":2000,\\\"archetype\\\":\\\"farming_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/heidelberg-fs\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"staasiens\\\",\\\"name\\\":\\\"Staasiens\\\",\\\"region\\\":\\\"farming town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-29.3,\\\"lng\\\":25.9,\\\"description\\\":\\\"Deep in the Free State farmlands, Staasiens represents the heartland of South African agriculture — wide fields, hardworking communities, and the quiet dignity of rural life.\\\",\\\"population_estimate\\\":800,\\\"archetype\\\":\\\"farming_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/staasiens\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"golden-gate\\\",\\\"name\\\":\\\"Golden Gate\\\",\\\"region\\\":\\\"nature reserve\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-28.5333,\\\"lng\\\":28.55,\\\"description\\\":\\\"The Golden Gate Highlands National Park is a landscape of dramatic sandstone cliffs, high-altitude grasslands, and the Basotho Cultural Village. This is where Lesotho's mountains meet the Free State plains in a blaze of golden light.\\\",\\\"population_estimate\\\":500,\\\"archetype\\\":\\\"nature_reserve\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/golden-gate\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"philippolis\\\",\\\"name\\\":\\\"Philippolis\\\",\\\"region\\\":\\\"heritage town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-30.0833,\\\"lng\\\":25.2667,\\\"description\\\":\\\"The oldest town in the Free State, Philippolis was founded by missionaries in 1822 and was once home to the famous Adam Kok III. The historic thatched-roof buildings and mission station tell a story of resilience and cultural exchange.\\\",\\\"population_estimate\\\":1200,\\\"archetype\\\":\\\"heritage_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/philippolis\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"trompsburg\\\",\\\"name\\\":\\\"Trompsburg\\\",\\\"region\\\":\\\"farming town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-30.0333,\\\"lng\\\":25.7833,\\\"description\\\":\\\"A quiet farming town in the southern Free State near the Lesotho border, Trompsburg is surrounded by sheep and cattle farms in the rolling grasslands. The town's annual agricultural show is the highlight of the social calendar.\\\",\\\"population_estimate\\\":1500,\\\"archetype\\\":\\\"farming_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/trompsburg\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"springfontein\\\",\\\"name\\\":\\\"Springfontein\\\",\\\"region\\\":\\\"heritage town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-30.2833,\\\"lng\\\":25.7,\\\"description\\\":\\\"On the historic railway line between Bloemfontein and the Cape, Springfontein is a small farming community with a proud Boer War heritage. The surrounding veld is classic Free State — wide skies, golden grass, and endless horizons.\\\",\\\"population_estimate\\\":1000,\\\"archetype\\\":\\\"heritage_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/springfontein\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"thaba-nchu\\\",\\\"name\\\":\\\"Thaba Nchu\\\",\\\"region\\\":\\\"cultural town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-29.2167,\\\"lng\\\":26.85,\\\"description\\\":\\\"Thaba Nchu means 'black mountain' in Sesotho and is the historical home of the Barolong people in the Free State. The town's Basotho heritage, annual cultural events, and community spirit make it a vital part of the province's identity.\\\",\\\"population_estimate\\\":15000,\\\"archetype\\\":\\\"cultural_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/thaba-nchu\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"mangaung\\\",\\\"name\\\":\\\"Mangaung\\\",\\\"region\\\":\\\"metropolitan\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-29.0852,\\\"lng\\\":26.1596,\\\"description\\\":\\\"The metropolitan municipality that includes Bloemfontein, Mangaung is where urban energy meets Free State soul. The University of the Free State brings youth culture and innovation, while the annual MACUFE festival is one of South Africa's premier arts events.\\\",\\\"population_estimate\\\":256000,\\\"archetype\\\":\\\"metropolitan\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/mangaung\\\",\\\"illustrative\\\":true}],\\\"hero_image\\\":\\\"https://images.unsplash.com/photo-1590001155093-a3c66ab0c3ff?w=1200\\u0026q=80\\\",\\\"description\\\":\\\"The heartland of South Africa, where golden grasslands stretch to the horizon and sandstone towns hold centuries of stories. Free State is home to 22 towns across rolling farmlands, the Maluti Mountains, and the Golden Gate Highlands.\\\",\\\"coordinators\\\":[{\\\"name\\\":\\\"Dineo Mosia\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"welkom\\\"},{\\\"name\\\":\\\"Palesa Judith Makhetha\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"senekal\\\"},{\\\"name\\\":\\\"Magauta Mapheleba\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"ladybrand\\\"},{\\\"name\\\":\\\"Sinoto Selepe\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"bethlehem\\\"},{\\\"name\\\":\\\"Xoliswa Portia Xhalabile\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"botshabelo\\\"},{\\\"name\\\":\\\"Magauta Mapheleba\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"ficksburg\\\"},{\\\"name\\\":\\\"Tshabalala Katleho Alfred\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"bloemfontein\\\"},{\\\"name\\\":\\\"Sipho Nkosi\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"harrismith\\\"},{\\\"name\\\":\\\"Mandla Sithole\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"kroonstad\\\"},{\\\"name\\\":\\\"Ayanda Radebe\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"phuthaditjhaba\\\"},{\\\"name\\\":\\\"Mpho Lekota\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"bloemfontein\\\"}],\\\"top_opportunities\\\":[{\\\"title\\\":\\\"NYDA National Youth Service Phase V — 100,000 Paid Opportunities\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"government\\\",\\\"town\\\":\\\"bloemfontein\\\"},{\\\"title\\\":\\\"FixEasy24 — Verified Service Providers Needed\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"ngo\\\",\\\"town\\\":\\\"bloemfontein\\\"},{\\\"title\\\":\\\"FrameSouth — Town Photographer \\u0026 Visual Partner\\\",\\\"type\\\":\\\"internship\\\",\\\"source\\\":\\\"ngo\\\",\\\"town\\\":\\\"bloemfontein\\\"},{\\\"title\\\":\\\"Ubuntu Academy — Business Profile \\u0026 Marketing Workshop\\\",\\\"type\\\":\\\"training\\\",\\\"source\\\":\\\"ngo\\\",\\\"town\\\":\\\"bloemfontein\\\"},{\\\"title\\\":\\\"Inside.Town — Podcast Host \\u0026 Town Voice\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"ngo\\\",\\\"town\\\":\\\"bloemfontein\\\"}]},\\\"lens\\\":\\\"investor\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"b:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\n7:null\\n\"])</script><script>self.__next_f.push([1,\"9:{\\\"metadata\\\":[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"Free State — Ubuntu Town Province | Ubuntu Town\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"The heartland of South Africa, where golden grasslands stretch to the horizon and sandstone towns hold centuries of stories. Free State is home to 22 towns acro\\\"}],[\\\"$\\\",\\\"link\\\",\\\"2\\\",{\\\"rel\\\":\\\"author\\\",\\\"href\\\":\\\"https://kekelebaka.com\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"name\\\":\\\"author\\\",\\\"content\\\":\\\"Keke Lebaka\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"name\\\":\\\"keywords\\\",\\\"content\\\":\\\"Ubuntu Town,South Africa,town coordinator,opportunity infrastructure,CV engine,workpacks,proof-based work,agentic economy,Ubuntu Intelligence,Kopano,ambassador network,community coordination,small towns,townships,job matching\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"name\\\":\\\"creator\\\",\\\"content\\\":\\\"Keke Lebaka\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"6\\\",{\\\"name\\\":\\\"publisher\\\",\\\"content\\\":\\\"Ubuntu Town\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"7\\\",{\\\"name\\\":\\\"robots\\\",\\\"content\\\":\\\"index, follow\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"8\\\",{\\\"name\\\":\\\"googlebot\\\",\\\"content\\\":\\\"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1\\\"}],[\\\"$\\\",\\\"link\\\",\\\"9\\\",{\\\"rel\\\":\\\"alternate\\\