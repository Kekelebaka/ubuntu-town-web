gned\",\"route\":\"/town/ladybrand\",\"illustrative\":false,\"coordinator_name\":\"Magauta Mapheleba\",\"youth_mapped\":0,\"active_signals\":0,\"open_opportunities\":0,\"lat\":-29.1947,\"lng\":27.4575,\"description\":\"Nestled against the Maloti mountain escarpment at the Lesotho border, Ladybrand is a charming town of sandstone buildings, art galleries, and some of the best farm stalls in the Free State. The nearby Basotho Cultural Village and Qhobosheane Cave paintings connect visitors to thousands of years of human settlement.\",\"population_estimate\":8500,\"archetype\":\"heritage_town\",\"opportunities\":[{\"id\":\"opp-ubun-ladybrand\",\"title\":\"Ubuntu Academy — Skills & Job Readiness Workshop\",\"type\":\"training\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-ladybrand\",\"metadata\":{\"ecosystem\":\"ubuntu_academy\"}},{\"id\":\"opp-orbi-ladybrand-2\",\"title\":\"Orbit Music — Youth AI Music Creation Workshop\",\"type\":\"training\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-ladybrand\",\"metadata\":{\"ecosystem\":\"orbit_music\"}},{\"id\":\"opp-insi-ladybrand-3\",\"title\":\"Inside.Town — Community Podcast Producer\",\"type\":\"volunteer\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-ladybrand\",\"metadata\":{\"ecosystem\":\"inside_town\"}}],\"businesses\":[{\"slug\":\"ladybrand\",\"name\":\"Ladybrand Farm Stall\",\"category\":\"food\",\"is_verified\":false,\"id\":\"seed-ladybrand-biz\",\"town_id\":null}],\"cv_count\":1},{\"slug\":\"ficksburg\",\"name\":\"Ficksburg\",\"region\":\"Setsoto · cherry capital\",\"district\":\"Thabo Mofutsanyana\",\"status\":\"building\",\"render_pct\":25,\"opportunity_potential\":54,\"heritage\":true,\"coordinator_status\":\"assigned\",\"route\":\"/town/ficksburg\",\"illustrative\":false,\"coordinator_name\":\"Magauta Mapheleba\",\"youth_mapped\":0,\"active_signals\":0,\"open_opportunities\":0,\"lat\":-28.8689,\"lng\":27.8825,\"description\":\"Ficksburg is the self-proclaimed Cherry Capital of South Africa, hosting the annual Cherry Festival each November when the orchards burst into bloom. The town's Masermeng Cultural Village offers authentic Basotho heritage experiences, while the surrounding farmlands produce some of the province's finest livestock.\",\"population_estimate\":12000,\"archetype\":\"agricultural_town\",\"opportunities\":[{\"id\":\"opp-fram-ficksburg\",\"title\":\"FrameSouth — Town Photographer / Visual Proof Creator\",\"type\":\"volunteer\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-ficksburg\",\"metadata\":{\"ecosystem\":\"framesouth\"}},{\"id\":\"opp-fixe-ficksburg-2\",\"title\":\"FixEasy24 — Verified Service Provider Registration\",\"type\":\"opportunity\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-ficksburg\",\"metadata\":{\"ecosystem\":\"fixeasy24\"}},{\"id\":\"opp-kasi-ficksburg-3\",\"title\":\"KasiBuy — Local Spaza / WhatsApp Store Listing\",\"type\":\"opportunity\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-ficksburg\",\"metadata\":{\"ecosystem\":\"kasibuy\"}}],\"businesses\":[{\"slug\":\"ficksburg\",\"name\":\"Cherry Festival Market\",\"category\":\"tourism\",\"is_verified\":false,\"id\":\"seed-ficksburg-biz\",\"town_id\":null}],\"events\":[{\"slug\":\"ficksburg\",\"title\":\"Cherry Festival\",\"description\":\"Annual cherry harvest celebration with tastings, music, and market stalls\",\"event_date\":\"2026-11-15\",\"id\":\"seed-ficksburg-evt\",\"town_id\":null}],\"services\":[{\"title\":\"Cherry Festival — November annually\",\"description\":\"Annual cherry harvest celebration. Tastings, music, market stalls.\",\"price_range\":\"R50 - R200\",\"category\":\"tourism\"},{\"title\":\"Masermeng Cultural Village\",\"description\":\"Authentic Basotho heritage experiences and traditional meals.\",\"price_range\":\"R100 - R300\",\"category\":\"tourism\"}],\"cv_count\":1},{\"slug\":\"clarens\",\"name\":\"Clarens\",\"region\":\"Dihlabeng · arts & Maluti\",\"district\":\"Thabo Mofutsanyana\",\"status\":\"building\",\"render_pct\":30,\"opportunity_potential\":58,\"heritage\":true,\"coordinator_status\":\"assigned\",\"route\":\"/town/clarens\",\"illustrative\":false,\"lat\":-28.5167,\"lng\":28.4167,\"description\":\"Known as the Jewel of the Free State, Clarens is an artistic village surrounded by sandstone cliffs and golden grasslands, home to dozens of galleries, craft shops, and the famous Clarens Brewery. The town attracts creatives and outdoor enthusiasts with hiking trails, fly-fishing, and the nearby Golden Gate Highlands.\",\"population_estimate\":5000,\"archetype\":\"art_village\",\"stories\":[{\"slug\":\"clarens\",\"title\":\"Art Village Rising\",\"content\":\"Clarens galleries now attract visitors from around the world. The annual Arts Festival brings thousands to our small mountain village.\",\"author_name\":\"Anna V.\",\"id\":\"seed-clarens-story\",\"town_id\":null}],\"businesses\":[{\"slug\":\"clarens\",\"name\":\"Clarens Brewery\",\"category\":\"food\",\"is_verified\":false,\"id\":\"seed-clarens-biz\",\"town_id\":null},{\"slug\":\"clarens\",\"name\":\"Clarens Village Square Art Gallery\",\"category\":\"tourism\",\"is_verified\":false,\"id\":\"seed-clarens-biz\",\"town_id\":null}],\"events\":[{\"slug\":\"clarens\",\"title\":\"Clarens Arts Festival\",\"description\":\"Annual arts and culture festival celebrating local talent\",\"event_date\":\"2026-09-20\",\"id\":\"seed-clarens-evt\",\"town_id\":null}],\"services\":[{\"title\":\"Clarens Village Square — art galleries\",\"description\":\"Over 20 galleries and craft shops in the sandstone village.\",\"price_range\":\"Free entry\",\"category\":\"tourism\"},{\"title\":\"Golden Gate Highlands — day visitor centre\",\"description\":\"Dramatic sandstone cliffs and high-altitude grasslands.\",\"price_range\":\"R40 - R80\",\"category\":\"tourism\"}]},{\"slug\":\"bethlehem\",\"name\":\"Bethlehem\",\"region\":\"Dihlabeng · eastern FS hub\",\"district\":\"Thabo Mofutsanyana\",\"status\":\"building\",\"render_pct\":25,\"opportunity_potential\":48,\"heritage\":false,\"coordinator_status\":\"assigned\",\"route\":\"/town/bethlehem\",\"illustrative\":false,\"coordinator_name\":\"Sinoto Selepe\",\"youth_mapped\":0,\"active_signals\":0,\"open_opportunities\":0,\"lat\":-28.2308,\"lng\":28.3075,\"description\":\"A small Karoo town with big dreams, Bethlehem serves as the commercial hub of the eastern Free State with stunning mountain views in every direction. The nearby Golden Gate Highlands National Park, with its dramatic sandstone cliffs and Basotho cultural heritage, draws visitors year-round.\",\"population_estimate\":16000,\"archetype\":\"gateway_town\",\"opportunities\":[{\"id\":\"opp-kasi-bethlehem\",\"title\":\"KasiBuy — Local Spaza / WhatsApp Store Listing\",\"type\":\"opportunity\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-bethlehem\",\"metadata\":{\"ecosystem\":\"kasibuy\"}},{\"id\":\"opp-fami-bethlehem-2\",\"title\":\"FamilyHouse — Home Hospitality Host Registration\",\"type\":\"opportunity\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-bethlehem\",\"metadata\":{\"ecosystem\":\"familyhouse\"}},{\"id\":\"opp-ecoc-bethlehem-3\",\"title\":\"EcoChar — 5-Day Charcoal Production Training\",\"type\":\"training\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-bethlehem\",\"metadata\":{\"ecosystem\":\"ecochar\"}}],\"businesses\":[{\"slug\":\"bethlehem\",\"name\":\"Maluti View B&B\",\"category\":\"hospitality\",\"is_verified\":false,\"id\":\"seed-bethlehem-biz\",\"town_id\":null}],\"cv_count\":2},{\"slug\":\"harrismith\",\"name\":\"Harrismith\",\"region\":\"Maluti-a-Phofung · N3 hub\",\"district\":\"Maluti-a-Phofung\",\"status\":\"building\",\"render_pct\":15,\"opportunity_potential\":52,\"heritage\":false,\"coordinator_status\":\"assigned\",\"route\":\"/town/harrismith\",\"illustrative\":false,\"coordinator_name\":\"Sipho Nkosi\",\"youth_mapped\":0,\"active_signals\":0,\"open_opportunities\":0,\"lat\":-28.27,\"lng\":29.13,\"description\":\"N3 crossroads town between Johannesburg and Durban, with Platberg mountain as its landmark. Gateway to the Drakensberg.\",\"opportunities\":[{\"id\":\"opp-kasi-harrismith\",\"title\":\"KasiBuy — Local Spaza / WhatsApp Store Listing\",\"type\":\"opportunity\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-harrismith\",\"metadata\":{\"ecosystem\":\"kasibuy\"}},{\"id\":\"opp-fami-harrismith-2\",\"title\":\"FamilyHouse — Home Hospitality Host Registration\",\"type\":\"opportunity\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-harrismith\",\"metadata\":{\"ecosystem\":\"familyhouse\"}},{\"id\":\"opp-ecoc-harrismith-3\",\"title\":\"EcoChar — 5-Day Charcoal Production Training\",\"type\":\"training\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-harrismith\",\"metadata\":{\"ecosystem\":\"ecochar\"}}],\"stories\":[{\"slug\":\"harrismith\",\"title\":\"N3 Crossroads Opportunity\",\"content\":\"Being on the N3 between Joburg and Durban means truckers stop here. We are turning that traffic into trade.\",\"author_name\":\"Sipho M.\",\"id\":\"seed-harrismith-story\",\"town_id\":null}],\"businesses\":[{\"slug\":\"harrismith\",\"name\":\"Platberg Mountain Resort\",\"category\":\"hospitality\",\"is_verified\":false,\"id\":\"seed-harrismith-biz\",\"town_id\":null}],\"cv_count\":1},{\"slug\":\"senekal\",\"name\":\"Senekal\",\"region\":\"Setsoto · agri town\",\"district\":\"Thabo Mofutsanyana\",\"status\":\"building\",\"render_pct\":25,\"opportunity_potential\":45,\"heritage\":false,\"coordinator_status\":\"assigned\",\"route\":\"/town/senekal\",\"illustrative\":false,\"coordinator_name\":\"Palesa Judith Makhetha\",\"youth_mapped\":0,\"active_signals\":0,\"open_opportunities\":0,\"lat\":-28.3167,\"lng\":27.6,\"description\":\"Maize and cattle farming town in the heart of the Setsoto municipality. Annual agricultural show draws the community together.\",\"opportunities\":[{\"id\":\"opp-ubun-senekal\",\"