\\\":\\\"training\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-brits\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"orbit_music\\\"}},{\\\"id\\\":\\\"opp-insi-brits-2\\\",\\\"title\\\":\\\"Inside.Town — Community Podcast Producer\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-brits\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"inside_town\\\"}},{\\\"id\\\":\\\"opp-fram-brits-3\\\",\\\"title\\\":\\\"FrameSouth — Town Photographer / Visual Proof Creator\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-brits\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"framesouth\\\"}}],\\\"businesses\\\":[{\\\"slug\\\":\\\"brits\\\",\\\"name\\\":\\\"Pilanesberg Game Reserve\\\",\\\"category\\\":\\\"tourism\\\",\\\"is_verified\\\":false,\\\"id\\\":\\\"seed-brits-biz\\\",\\\"town_id\\\":null}],\\\"cv_count\\\":1},{\\\"slug\\\":\\\"rustenburg\\\",\\\"name\\\":\\\"Rustenburg\\\",\\\"region\\\":\\\"Rustenburg · platinum belt\\\",\\\"district\\\":\\\"Rustenburg\\\",\\\"status\\\":\\\"building\\\",\\\"render_pct\\\":33,\\\"opportunity_potential\\\":55,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"assigned\\\",\\\"route\\\":\\\"/town/rustenburg\\\",\\\"illustrative\\\":false,\\\"coordinator_name\\\":\\\"Kagiso Mothibi\\\",\\\"youth_mapped\\\":134,\\\"active_signals\\\":1,\\\"open_opportunities\\\":3,\\\"lat\\\":-25.6672,\\\"lng\\\":27.2427,\\\"description\\\":\\\"The Platinum Capital of the World, Rustenburg sits between the Pilanesberg Game Reserve and the Magaliesberg Mountains. The city's platinum mines power the global economy while Sun City and the Bushveld offer world-class entertainment.\\\",\\\"population_estimate\\\":125000,\\\"archetype\\\":\\\"mining_city\\\",\\\"opportunities\\\":[{\\\"id\\\":\\\"opp-plat-rstnb\\\",\\\"title\\\":\\\"Rustenburg Platinum Belt Skills Programme\\\",\\\"type\\\":\\\"training\\\",\\\"