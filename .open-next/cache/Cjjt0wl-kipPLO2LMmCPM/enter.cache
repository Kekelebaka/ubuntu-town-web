ies\\\":2,\\\"lat\\\":-33.9321,\\\"lng\\\":18.8602,\\\"description\\\":\\\"South Africa's second-oldest town and wine capital, Stellenbosch combines centuries-old Cape Dutch architecture with a thriving university town energy. Oak-lined streets, world-class vineyards, and a buzzing food scene make it both historic and thoroughly modern.\\\",\\\"population_estimate\\\":180000,\\\"archetype\\\":\\\"university_town\\\",\\\"opportunities\\\":[{\\\"id\\\":\\\"opp-family-stell\\\",\\\"title\\\":\\\"FamilyHouse — Home Host \\u0026 Accommodation Partner\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-stell\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"familyhouse\\\"}}],\\\"signals\\\":[{\\\"id\\\":\\\"sig-stell-1\\\",\\\"title\\\":\\\"Streetlight repair — Bird Street\\\",\\\"category\\\":\\\"infrastructure\\\",\\\"status\\\":\\\"resolved\\\",\\\"town_id\\\":\\\"town-stell\\\"}],\\\"businesses\\\":[{\\\"id\\\":\\\"biz-stell-1\\\",\\\"name\\\":\\\"Kayamandi Crafts Collective\\\",\\\"category\\\":\\\"retail\\\",\\\"is_verified\\\":true,\\\"town_id\\\":\\\"town-stell\\\"},{\\\"slug\\\":\\\"stellenbosch\\\",\\\"name\\\":\\\"Stellenbosch Wine Estates\\\",\\\"category\\\":\\\"food\\\",\\\"is_verified\\\":false,\\\"id\\\":\\\"seed-stellenbosch-biz\\\",\\\"town_id\\\":null}]},{\\\"slug\\\":\\\"george\\\",\\\"name\\\":\\\"George\\\",\\\"region\\\":\\\"Garden Route · regional hub\\\",\\\"district\\\":\\\"Garden Route\\\",\\\"status\\\":\\\"building\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":55,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"assigned\\\",\\\"route\\\":\\\"/town/george\\\",\\\"illustrative\\\":true,\\\"coordinator_name\\\":\\\"Anele Swarts\\\",\\\"lat\\\":-33.9608,\\\"lng\\\":22.4617,\\\"description\\\":\\\"Gateway to the Garden Route, George is nestled between the Outeniqua Mountains and the Indian Ocean, offering access to some of South Africa's most stunning natural landscapes. The town is a hub for outdoor adventure — hiking, mountain biking, and watersports.\\\",\\\"population_estimate\\\":80000,\\\"archetype\\\":\\\"garden_route\\\",\\\"opportunities\\\":[{\\\"id\\\":\\\"opp-kasi-george\\\",\\\"title\\\":\\\"KasiBuy — Local Spaza / WhatsApp Store Listing\\\",\\\"type\\\":\\\"opportunity\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-george\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"kasibuy\\\"}},{\\\"id\\\":\\\"opp-fixe-george\\\",\\\"title\\\":\\\"FixEasy24 — Verified Service Provider Registration\\\",\\\"type\\\":\\\"opportunity\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-george\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"fixeasy24\\\"}},{\\\"id\\\":\\\"opp-ubun-george\\\",\\\"title\\\":\\\"Ubuntu Academy — Skills \\u0026 Job Readiness Workshop\\\",\\\"type\\\":\\\"training\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-george\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"ubuntu_academy\\\"}}],\\\"businesses\\\":[{\\\"slug\\\":\\\"george\\\",\\\"name\\\":\\\"Outeniqua Transport Museum\\\",\\\"category\\\":\\\"tourism\\\",\\\"is_verified\\\":false,\\\"id\\\":\\\"seed-george-biz\\\",\\\"town_id\\\":null}]},{\\\"slug\\\":\\\"paarl\\\",\\\"name\\\":\\\"Paarl\\\",\\\"region\\\":\\\"Cape Winelands · wine \\u0026 granite\\\",\\\"district\\\":\\\"Cape Winelands\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":19,\\\"opportunity_potential\\\":50,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"assigned\\\",\\\"route\\\":\\\"/town/paarl\\\",\\\"illustrative\\\":true,\\\"coordinator_name\\\":\\\"Kagiso Motaung\\\",\\\"youth_mapped\\\":38,\\\"active_signals\\\":0,\\\"open_opportunities\\\":1,\\\"lat\\\":-33.734,\\\"lng\\\":18.9558,\\\"description\\\":\\\"The Pearl of the Winelands sits beneath the massive Paarl Rock, where Afrikaans language and culture were born at the Language Monument. The town's vineyards, olive groves, and historic Main Street make it a cornerstone of Cape heritage.\\\",\\\"population_estimate\\\":110000,\\\"archetype\\\":\\\"winelands_town\\\",\\\"opportunities\\\":[{\\\"id\\\":\\\"opp-kasi-paarl\\\",\\\"title\\\":\\\"KasiBuy — Local Spaza / WhatsApp Store Listing\\\",\\\"type\\\":\\\"opportunity\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-paarl\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"kasibuy\\\"}},{\\\"id\\\":\\\"opp-fami-paarl-2\\\",\\\"title\\\":\\\"FamilyHouse — Home Hospitality Host Registration\\\",\\\"type\\\":\\\"opportunity\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-paarl\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"familyhouse\\\"}},{\\\"id\\\":\\\"opp-ecoc-paarl-3\\\",\\\"title\\\":\\\"EcoChar — 5-Day Charcoal Production Training\\\",\\\"type\\\":\\\"training\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-paarl\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"ecochar\\\"}}]},{\\\"slug\\\":\\\"knysna\\\",\\\"name\\\":\\\"Knysna\\\",\\\"region\\\":\\\"Garden Route · lagoon \\u0026 forest\\\",\\\"district\\\":\\\"Garden Route\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":48,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/knysna\\\",\\\"illustrative\\\":true,\\\"lat\\\":-34.0362,\\\"lng\\\":23.0475,\\\"description\\\":\\\"The Jewel of the Garden Route, Knysna wraps around a vast lagoon between two dramatic headlands, with indigenous forest, oyster farms, and the famous Knysna Heads creating one of South Africa's most beautiful settings.\\\",\\\"population_estimate\\\":52000,\\\"archetype\\\":\\\"garden_route\\\",\\\"businesses\\\":[{\\\"slug\\\":\\\"knysna\\\",\\\"name\\\":\\\"Knysna Heads Restaurant\\\",\\\"category\\\":\\\"food\\\",\\\"is_verified\\\":false,\\\"id\\\":\\\"seed-knysna-biz\\\",\\\"town_id\\\":null}],\\\"events\\\":[{\\\"slug\\\":\\\"knysna\\\",\\\"title\\\":\\\"Knysna Oyster Festival\\\",\\\"description\\\":\\\"Food, sport, and oysters on the Garden Route\\\",\\\"event_date\\\":\\\"2026-07-01\\\",\\\"id\\\":\\\"seed-knysna-evt\\\",\\\"town_id\\\":null}]},{\\\"slug\\\":\\\"hermanus\\\",\\\"name\\\":\\\"Hermanus\\\",\\\"region\\\":\\\"Overberg · whale coast\\\",\\\"district\\\":\\\"Overberg\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":46,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/hermanus\\\",\\\"illustrative\\\":true,\\\"lat\\\":-34.4172,\\\"lng\\\":19.2345,\\\"description\\\":\\\"South Africa's premier whale-watching destination, Hermanus hosts the annual Whale Festival when southern right whales arrive in Walker Bay. The Hemel-en-Aarde Valley behind the town produces world-class Pinot Noir and Chardonnay.\\\",\\\"population_estimate\\\":12000,\\\"archetype\\\":\\\"coastal_town\\\",\\\"businesses\\\":[{\\\"slug\\\":\\\"hermanus\\\",\\\"name\\\":\\\"Hermanus Whale Watching\\\",\\\"category\\\":\\\"tourism\\\",\\\"is_verified\\\":false,\\\"id\\\":\\\"seed-hermanus-biz\\\",\\\"town_id\\\":null}],\\\"events\\\":[{\\\"slug\\\":\\\"hermanus\\\",\\\"title\\\":\\\"Whale Festival\\\",\\\"description\\\":\\\"Celebration of the southern right whale season\\\",\\\"event_date\\\":\\\"2026-10-01\\\",\\\"id\\\":\\\"seed-hermanus-evt\\\",\\\"town_id\\\":null}]},{\\\"slug\\\":\\\"mossel-bay\\\",\\\"name\\\":\\\"Mossel Bay\\\",\\\"region\\\":\\\"Garden Route · coast \\u0026 energy\\\",\\\"district\\\":\\\"Garden Route\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":45,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/mossel-bay\\\",\\\"illustrative\\\":true,\\\"lat\\\":-34.175,\\\"lng\\\":22.1353,\\\"description\\\":\\\"Where Bartholomew Diaz first landed in 1488, Mossel Bay is a coastal town where history meets surf culture. The Dias Museum, the Post Office Tree, and golden beaches tell a story of discovery and ocean life spanning centuries.\\\",\\\"population_estimate\\\":59000,\\\"archetype\\\":\\\"coastal_town\\\"},{\\\"slug\\\":\\\"oudtshoorn\\\",\\\"name\\\":\\\"Oudtshoorn\\\",\\\"region\\\":\\\"Garden Route · Klein Karoo \\u0026 Cango Caves\\\",\\\"district\\\":\\\"Garden Route\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":44,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/oudtshoorn\\\",\\\"illustrative\\\":true,\\\"lat\\\":-33.5833,\\\"lng\\\":22.2,\\\"description\\\":\\\"Ostrich capital of South Africa, home to the famous Cango Caves and annual Klein Karoo Nasionale Kunstefees.\\\"},{\\\"slug\\\":\\\"saldanha\\\",\\\"name\\\":\\\"Saldanha\\\",\\\"region\\\":\\\"West Coast · port \\u0026 industry\\\",\\\"district\\\":\\\"West Coast\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":42,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/saldanha\\\",\\\"illustrative\\\":true,\\\"lat\\\":-33.0167,\\\"lng\\\":17.9333,\\\"description\\\":\\\"Deep-water port town on the West Coast, industrial hub and gateway to the West Coast National Park.\\\"},{\\\"slug\\\":\\\"swellendam\\\",\\\"name\\\":\\\"Swellendam\\\",\\\"region\\\":\\\"Overberg · historic Cape\\\",\\\"district\\\":\\\"Overberg\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":38,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/swellendam\\\",\\\"illustrative\\\":true,\\\"lat\\\":-34.0237,\\\"lng\\\":20.4524,\\\"description\\\":\\\"One of the oldest towns in South Africa, Swellendam is a heritage gem with perfectly preserved Cape Dutch buildings, art galleries, and the annual Berry Festival. The Bontebok National Park nearby protects one of the rarest antelope species on earth.\\\",\\\"population_estimate\\\":8000,\\\"archetype\\\":\\\"heritage_town\\\"},{\\\"slug\\\":\\\"grabouw\\\",\\\"name\\\":\\\"Grabouw\\\",\\\"region\\\":\\\"Overberg · Elgin apples\\\",\\\"district\\\":\\\"Overberg\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":36,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/grabouw\\\",\\\"illustrative\\\":true,\\\"lat\\\":-34.15,\\\"lng\\\":19.0333,\\\"description\\\":\\\"Apple capital of South Africa in the Elgin Valley, surrounded by orchards and cool-climate vineyards.\\\"},{\\\"slug\\\":\\\"robertson\\\",\\\"name\\\":\\\"Robertson\\\",\\\"region\\\":\\\"Cape Winelands · wine \\u0026 roses\\\",\\\"district\\\":\\\"Cape Winelands\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":34,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/robertson\\\",\\\"illustrative\\\":true,\\\"lat\\\":-33.8,\\\"lng\\\":19.8833,\\\"description\\\":\\\"Wine and roses town in the Breede River Valley, heart of the Robertson Wine Route.\\\"},{\\\"slug\\\":\\\"malmesbury\\\",\\\"name\\\":\\\"Malmesbury\\\",\\\"region\\\":\\\"West Coast · Swartland wheat\\\",\\\"district\\\":\\\"West Coast\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":32,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/malmesbury\\\",\\\"illustrative\\\":true,\\\"lat\\\":-33.3833,\\\"lng\\\":18.7167,\\\"description\\\":\\\"Swartland wheat town and gateway to the Swartland wine region, with historic Cape Dutch architecture.\\\"},{\\\"slug\\\":\\\"worcester\\\",\\\"name\\\":\\\"Worcester\\\",\\\"region\\\":\\\"Cape Winelands · Breede Valley\\\",\\\"district\\\":\\\"Cape Winelands\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":40,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/worcester\\\",\\\"illustrative\\\":true,\\\"lat\\\":-33.6552,\\\"lng\\\":19.4273,\\\"description\\\":\\\"The largest town in the Boland, Worcester sits in a wine-rich valley surrounded by dramatic mountain ranges. The town's art scene, the Karoo National Botanical Garden, and its position on the N1 make it a vital Free State–Western Cape link.\\\",\\\"population_estimate\\\":58000,\\\"archetype\\\":\\\"boland_town\\\"},{\\\"slug\\\":\\\"caledon\\\",\\\"name\\\":\\\"Caledon\\\",\\\"region\\\":\\\"Overberg · agri \\u0026 spa\\\",\\\"district\\\":\\\"Overberg\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/caledon\\\",\\\"illustrative\\\":true,\\\"lat\\\":-34.2333,\\\"lng\\\":19.4333,\\\"description\\\":\\\"Overberg agri-town known for its hot springs, barley fields, and annual Caledon Wildflower Show.\\\"},{\\\"slug\\\":\\\"vredenburg\\\",\\\"name\\\":\\\"Vredenburg\\\",\\\"region\\\":\\\"West Coast · regional hub\\\",\\\"district\\\":\\\"West Coast\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/vredenburg\\\",\\\"illustrative\\\":true,\\\"lat\\\":-32.9,\\\"lng\\\":17.9833,\\\"description\\\":\\\"West Coast regional hub serving the fishing and mining communities of the Saldanha Bay area.\\\"},{\\\"slug\\\":\\\"beaufort-west\\\",\\\"name\\\":\\\"Beaufort West\\\",\\\"region\\\":\\\"Central Karoo · N1 gateway\\\",\\\"district\\\":\\\"Central Karoo\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":28,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/beaufort-west\\\",\\\"illustrative\\\":true,\\\"lat\\\":-33.2833,\\\"lng\\\":22.5833,\\\"description\\\":\\\"Karoo gateway on the N1, the halfway mark between Cape Town and Johannesburg with Karoo hospitality.\\\"},{\\\"slug\\\":\\\"cape-town\\\",\\\"name