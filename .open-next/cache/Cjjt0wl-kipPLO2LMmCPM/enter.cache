da N.\",\"id\":\"seed-east-london-story\",\"town_id\":null}],\"businesses\":[{\"id\":\"biz-el-1\",\"name\":\"Mdantsane Youth Centre\",\"category\":\"education\",\"is_verified\":true,\"town_id\":\"town-el\"}],\"access_points\":[{\"id\":\"ap-el-1\",\"name\":\"Mdantsane Library\",\"category\":\"library\",\"is_verified\":true,\"town_id\":\"town-el\"}],\"services\":[{\"title\":\"Buffalo City TVET\",\"description\":\"Business, engineering, and hospitality programmes.\",\"price_range\":\"R4,000 - R10,000/year\",\"category\":\"education\"},{\"title\":\"East London Museum — dodo exhibit\",\"description\":\"Home to the only complete dodo skeleton in the world.\",\"price_range\":\"R30 - R50\",\"category\":\"tourism\"}]},{\"slug\":\"gqeberha\",\"name\":\"Gqeberha\",\"region\":\"Nelson Mandela Bay · port city\",\"district\":\"Nelson Mandela Bay\",\"status\":\"building\",\"render_pct\":46,\"opportunity_potential\":58,\"heritage\":true,\"coordinator_status\":\"assigned\",\"route\":\"/town/gqeberha\",\"illustrative\":false,\"coordinator_name\":\"Nomsa Plaatjes\",\"youth_mapped\":210,\"active_signals\":0,\"open_opportunities\":2,\"lat\":-33.9608,\"lng\":25.6022,\"description\":\"Formerly Port Elizabeth, Gqeberha is the Friendly City — a coastal metropolis where the St Croix Island penguins, Shark Rock Pier, and the annual Ironman triathlon define a city of sea and sport.\",\"population_estimate\":312000,\"archetype\":\"coastal_city\",\"opportunities\":[{\"id\":\"opp-fami-pe\",\"title\":\"FamilyHouse — Home Hospitality Host Registration\",\"type\":\"opportunity\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-pe\",\"metadata\":{\"ecosystem\":\"familyhouse\"}},{\"id\":\"opp-ecoc-pe-2\",\"title\":\"EcoChar — 5-Day Charcoal Production Training\",\"type\":\"training\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-pe\",\"metadata\":{\"ecosystem\":\"ecochar\"}},{\"id\":\"opp-bunt-pe-3\",\"title\":\"BuntuBar — Mobile Bar Event Workshop\",\"type\":\"training\",\"