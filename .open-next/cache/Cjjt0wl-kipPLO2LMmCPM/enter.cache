th-story\",\"town_id\":null}],\"businesses\":[{\"slug\":\"harrismith\",\"name\":\"Platberg Mountain Resort\",\"category\":\"hospitality\",\"is_verified\":false,\"id\":\"seed-harrismith-biz\",\"town_id\":null}],\"cv_count\":1},{\"slug\":\"senekal\",\"name\":\"Senekal\",\"region\":\"Setsoto · agri town\",\"district\":\"Thabo Mofutsanyana\",\"status\":\"building\",\"render_pct\":25,\"opportunity_potential\":45,\"heritage\":false,\"coordinator_status\":\"assigned\",\"route\":\"/town/senekal\",\"illustrative\":false,\"coordinator_name\":\"Palesa Judith Makhetha\",\"youth_mapped\":0,\"active_signals\":0,\"open_opportunities\":0,\"lat\":-28.3167,\"lng\":27.6,\"description\":\"Maize and cattle farming town in the heart of the Setsoto municipality. Annual agricultural show draws the community together.\",\"opportunities\":[{\"id\":\"opp-ubun-senekal\",\"title\":\"Ubuntu Academy — Skills & Job Readiness Workshop\",\"type\":\"training\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-senekal\",\"metadata\":{\"ecosystem\":\"ubuntu_academy\"}},{\"id\":\"opp-orbi-senekal-2\",\"title\":\"Orbit Music — Youth AI Music Creation Workshop\",\"type\":\"training\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-senekal\",\"metadata\":{\"ecosystem\":\"orbit_music\"}},{\"id\":\"opp-insi-senekal-3\",\"title\":\"Inside.Town — Community Podcast Producer\",\"type\":\"volunteer\",\"source\":\"ngo\",\"deadline_date\":null,\"town_id\":\"town-senekal\",\"metadata\":{\"ecosystem\":\"inside_town\"}}],\"cv_count\":1},{\"slug\":\"phuthaditjhaba\",\"name\":\"Phuthaditjhaba\",\"region\":\"Maluti-a-Phofung · Qwaqwa\",\"district\":\"Maluti-a-Phofung\",\"status\":\"ghost\",\"render_pct\":15,\"opportunity_potential\":45,\"heritage\":true,\"coordinator_status\":\"assigned\",\"route\":\"/town/phuthaditjhaba\",\"illustrative\":true,\"coordinator_name\":\"Ayanda Radebe\",\"youth_mapped\":0,\"active_signals\":0,\"open_opportunities\":0,\"lat\":-28.5333,\"lng\":28.8333,\"description\":\"