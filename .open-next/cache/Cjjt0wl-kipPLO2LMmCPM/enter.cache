:\\\"Ga-Segonyana\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":32,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/kuruman\\\",\\\"illustrative\\\":true,\\\"lat\\\":-27.45,\\\"lng\\\":23.4333,\\\"description\\\":\\\"The Eye of Kuruman — a natural spring that produces 20 million litres of water daily from the Kalahari — has sustained this town for millennia. The Moffat Mission here was a launchpad for Christianity in southern Africa.\\\",\\\"population_estimate\\\":10000,\\\"archetype\\\":\\\"mission_heritage\\\"},{\\\"slug\\\":\\\"calvinia\\\",\\\"name\\\":\\\"Calvinia\\\",\\\"region\\\":\\\"Hantam · Karoo heartland\\\",\\\"district\\\":\\\"Hantam\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":25,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/calvinia\\\",\\\"illustrative\\\":true,\\\"lat\\\":-31.4833,\\\"lng\\\":19.7833,\\\"description\\\":\\\"Namaqualand town famous for spring wildflowers and the annual Calvinia Namaqualand Cherry Festival.\\\"},{\\\"slug\\\":\\\"sutherland\\\",\\\"name\\\":\\\"Sutherland\\\",\\\"region\\\":\\\"Karoo · telescope town\\\",\\\"district\\\":\\\"Karoo Hoogland\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":28,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/sutherland\\\",\\\"illustrative\\\":true,\\\"lat\\\":-32.4,\\\"lng\\\":20.6833,\\\"description\\\":\\\"Coldest town in South Africa, home to the South African Large Telescope (SALT) and pristine Karoo night skies.\\\"},{\\\"slug\\\":\\\"colesberg\\\",\\\"name\\\":\\\"Colesberg\\\",\\\"region\\\":\\\"karoo town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-30.7167,\\\"lng\\\":25.1,\\\"description\\\":\\\"A Karoo town at the crossroads of the N1 and N9, Colesberg is where travellers stop and Karoo lamb dinners are a tradition. The town's sheepdogs and merino wool are legendary.\\\",\\\"population_estimate\\\":5000,\\\"archetype\\\":\\\"karoo_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/colesberg\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"postmasburg\\\",\\\"name\\\":\\\"Postmasburg\\\",\\\"region\\\":\\\"mining town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-28.3333,\\\"lng\\\":23.0667,\\\"description\\\":\\\"A mining town in the Northern Cape's iron ore belt, Postmasburg is where mineral extraction meets the vast Kalahari landscape.\\\",\\\"population_estimate\\\":6000,\\\"archetype\\\":\\\"mining_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/postmasburg\\\",\\\"illustrative\\\":true}],\\\"hero_image\\\":\\\"https://images.unsplash.com/photo-1509316975850-ff9c5deb0cd9?w=1200\\u0026q=80\\\",\\\"description\\\":\\\"South Africa's largest and most sparsely populated province — 7 towns across the diamond coast, Namaqualand's spring flowers, and the vast Karoo. The Northern Cape is frontier country.\\\",\\\"coordinators\\\":[{\\\"name\\\":\\\"Busisiwe Nyathi\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"springbok\\\"},{\\\"name\\\":\\\"Dineo Sethole\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"upington\\\"},{\\\"name\\\":\\\"Johannes Louw\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"de-aar\\\"},{\\\"name\\\":\\\"Thandi Willemse\\\",\\\"status\\\":\\\"active\\\",\\\"town\\\":\\\"kimberley\\\"}],\\\"top_opportunities\\\":[{\\\"title\\\":\\\"Northern Cape Solar Farm Technician Training\\\",\\\"type\\\":\\\"training\\\",\\\"source\\\":\\\"private\\\",\\\"town\\\":\\\"upington\\\"},{\\\"title\\\":\\\"Ubuntu Town Coordinator — Springbok\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"ngo\\\",\\\"town\\\":\\\"springbok\\\"},{\\\"title\\\":\\\"Orbit Music — Youth AI Music Creation Workshop\\\",\\\"type\\\":\\\"training\\\",\\\"source\\\":\\\"ngo\\\",\\\"town\\\":\\\"kimberley\\\"},{\\\"title\\\":\\\"Inside.Town — Community Podcast Producer\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"ngo\\\",\\\"town\\\":\\\"kimberley\\\"},{\\\"title\\\":\\\"FrameSouth — Town Photographer / Visual Proof Creator\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"ngo\\\",\\\"town\\\":\\\"kimberley\\\"}]}],\\\"lens\\\":\\\"investor\\\"}]\\n\"])</script><script>self.__next_f.push([1,\"b:[[\\\"$\\\",\\\"meta\\\",\\\"0\\\",{\\\"charSet\\\":\\\"utf-8\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"viewport\\\",\\\"content\\\":\\\"width=device-width, initial-scale=1\\\"}]]\\n7:null\\n\"])</script><script>self.__next_f.push([1,\"9:{\\\"metadata\\\":[[\\\"$\\\",\\\"title\\\",\\\"0\\\",{\\\"children\\\":\\\"Ubuntu Town — 1 Million CVs. 1 Million Opportunities.\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"1\\\",{\\\"name\\\":\\\"description\\\",\\\"content\\\":\\\"Ubuntu Town OS builds community opportunity infrastructure for South African towns. Connecting communities with verified opportunities, CV creation, and coordinator networks. When AI agents allocate opportunity, communities without structured data don't exist — Ubuntu Town builds the data layer first.\\\"}],[\\\"$\\\",\\\"link\\\",\\\"2\\\",{\\\"rel\\\":\\\"author\\\",\\\"href\\\":\\\"https://kekelebaka.com\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"3\\\",{\\\"name\\\":\\\"author\\\",\\\"content\\\":\\\"Keke Lebaka\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"4\\\",{\\\"name\\\":\\\"keywords\\\",\\\"content\\\":\\\"Ubuntu Town,South Africa,town coordinator,opportunity infrastructure,CV engine,workpacks,proof-based work,agentic economy,Ubuntu Intelligence,Kopano,ambassador network,community coordination,small towns,townships,job matching\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"5\\\",{\\\"name\\\":\\\"creator\\\",\\\"content\\\":\\\"Keke Lebaka\\\"}],[\\\"$\\\",\\\"meta\\\",\\\"6\\\",{\\\"name\\\":\\\"publisher\\\",\\\"content\\\":\\\"Ubuntu Town\\\"}],[\\\"$