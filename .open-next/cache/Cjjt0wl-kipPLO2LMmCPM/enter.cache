\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"jagersfontein\\\",\\\"name\\\":\\\"Jagersfontein\\\",\\\"region\\\":\\\"mining heritage\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-29.7833,\\\"lng\\\":25.4333,\\\"description\\\":\\\"One of the oldest diamond towns in South Africa, Jagersfontein was where diamonds were first discovered in the 1870s — even before Kimberley. The historic town square and mining heritage tell the story of the diamond rush that changed the world.\\\",\\\"population_estimate\\\":1800,\\\"archetype\\\":\\\"mining_heritage\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/jagersfontein\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"villiers\\\",\\\"name\\\":\\\"Villiers\\\",\\\"region\\\":\\\"farming town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-27.1167,\\\"lng\\\":28.55,\\\"description\\\":\\\"A small town along the N3 between Johannesburg and Durban, Villiers is a Free State crossroads where travellers stop and locals carry on with farming life. The surrounding landscape is classic highveld — rolling grass and big skies.\\\",\\\"population_estimate\\\":1500,\\\"archetype\\\":\\\"farming_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/villiers\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"heidelberg-fs\\\",\\\"name\\\":\\\"Heidelberg FS\\\",\\\"region\\\":\\\"farming town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-29.5167,\\\"lng\\\":26.65,\\\"description\\\":\\\"A small farming community on the banks of the Riet River, Heidelberg in the Free State is where generations of farming families have built a life on the land. The town's churches and school are the pillars of the community.\\\",\\\"population_estimate\\\":2000,\\\"archetype\\\":\\\"farming_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/heidelberg-fs\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"staasiens\\\",\\\"name\\\":\\\"Staasiens\\\",\\\"region\\\":\\\"farming town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-29.3,\\\"lng\\\":25.9,\\\"description\\\":\\\"Deep in the Free State farmlands, Staasiens represents the heartland of South African agriculture — wide fields, hardworking communities, and the quiet dignity of rural life.\\\",\\\"population_estimate\\\":800,\\\"archetype\\\":\\\"farming_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/staasiens\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"golden-gate\\\",\\\"name\\\":\\\"Golden Gate\\\",\\\"region\\\":\\\"nature reserve\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-28.5333,\\\"lng\\\":28.55,\\\"description\\\":\\\"The Golden Gate Highlands National Park is a landscape of dramatic sandstone cliffs, high-altitude grasslands, and the Basotho Cultural Village. This is where Lesotho's mountains meet the Free State plains in a blaze of golden light.\\\",\\\"population_estimate\\\":500,\\\"archetype\\\":\\\"nature_reserve\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/golden-gate\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"philippolis\\\",\\\"name\\\":\\\"Philippolis\\\",\\\"region\\\":\\\"heritage town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-30.0833,\\\"lng\\\":25.2667,\\\"description\\\":\\\"The oldest town in the Free State, Philippolis was founded by missionaries in 1822 and was once home to the famous Adam Kok III. The historic thatched-roof buildings and mission station tell a story of resilience and cultural exchange.\\\",\\\"population_estimate\\\":1200,\\\"archetype\\\":\\\"heritage_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/philippolis\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"trompsburg\\\",\\\"name\\\":\\\"Trompsburg\\\",\\\"region\\\":\\\"farming town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-30.0333,\\\"lng\\\":25.7833,\\\"description\\\":\\\"A quiet farming town in the southern Free State near the Lesotho border, Trompsburg is surrounded by sheep and cattle farms in the rolling grasslands. The town's annual agricultural show is the highlight of the social calendar.\\\",\\\"population_estimate\\\":1500,\\\"archetype\\\":\\\"farming_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/trompsburg\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"springfontein\\\",\\\"name\\\":\\\"Springfontein\\\",\\\"region\\\":\\\"heritage town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-30.2833,\\\"lng\\\":25.7,\\\"description\\\":\\\"On the historic railway line between Bloemfontein and the Cape, Springfontein is a small farming community with a proud Boer War heritage. The surrounding veld is classic Free State — wide skies, golden grass, and endless horizons.\\\",\\\"population_estimate\\\":1000,\\\"archetype\\\":\\\"heritage_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/springfontein\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"thaba-nchu\\\",\\\"name\\\":\\\"Thaba Nchu\\\",\\\"region\\\":\\\"cultural town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-29.2167,\\\"lng\\\":26.85,\\\"description\\\":\\\"Thaba Nchu means 'black mountain' in Sesotho and is the historical home of the Barolong people in the Free State. The town's Basotho heritage, annual cultural events, and community spirit make it a vital part of the province's identity.\\\",\\\"population_estimate\\\":15000,\\\"archetype\\\":\\\"cultural_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/thaba-nchu