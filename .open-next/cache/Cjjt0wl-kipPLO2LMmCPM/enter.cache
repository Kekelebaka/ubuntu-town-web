itude grasslands.\\\",\\\"price_range\\\":\\\"R40 - R80\\\",\\\"category\\\":\\\"tourism\\\"}]},{\\\"slug\\\":\\\"bethlehem\\\",\\\"name\\\":\\\"Bethlehem\\\",\\\"region\\\":\\\"Dihlabeng · eastern FS hub\\\",\\\"district\\\":\\\"Thabo Mofutsanyana\\\",\\\"status\\\":\\\"building\\\",\\\"render_pct\\\":25,\\\"opportunity_potential\\\":48,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"assigned\\\",\\\"route\\\":\\\"/town/bethlehem\\\",\\\"illustrative\\\":false,\\\"coordinator_name\\\":\\\"Sinoto Selepe\\\",\\\"youth_mapped\\\":0,\\\"active_signals\\\":0,\\\"open_opportunities\\\":0,\\\"lat\\\":-28.2308,\\\"lng\\\":28.3075,\\\"description\\\":\\\"A small Karoo town with big dreams, Bethlehem serves as the commercial hub of the eastern Free State with stunning mountain views in every direction. The nearby Golden Gate Highlands National Park, with its dramatic sandstone cliffs and Basotho cultural heritage, draws visitors year-round.\\\",\\\"population_estimate\\\":16000,\\\"archetype\\\":\\\"gateway_town\\\",\\\"opportunities\\\":[{\\\"id\\\":\\\"opp-kasi-bethlehem\\\",\\\"title\\\":\\\"KasiBuy — Local Spaza / WhatsApp Store Listing\\\",\\\"type\\\":\\\"opportunity\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-bethlehem\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"kasibuy\\\"}},{\\\"id\\\":\\\"opp-fami-bethlehem-2\\\",\\\"title\\\":\\\"FamilyHouse — Home Hospitality Host Registration\\\",\\\"type\\\":\\\"opportunity\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-bethlehem\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"familyhouse\\\"}},{\\\"id\\\":\\\"opp-ecoc-bethlehem-3\\\",\\\"title\\\":\\\"EcoChar — 5-Day Charcoal Production Training\\\",\\\"type\\\":\\\"training\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-bethlehem\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"ecochar\\\"}}],\\\"businesses\\\":[{\\\"slug\\\":\\\"bethlehem\\\",\\\"name\\\":\\\"Maluti Vi