"px-4 py-2\"><a class=\"font-semibold text-[#5B2A86] hover:underline\" href=\"/os/town/upington\">Upington</a></td><td class=\"px-4 py-2 text-[#5A4E6D]\">—</td><td class=\"px-4 py-2 text-[#5A4E6D]\">—</td><td class=\"px-4 py-2 text-[#5A4E6D]\">—</td><td class=\"px-4 py-2\"><span class=\"rounded-full px-2 py-0.5 text-[10px] font-semibold bg-[#F3EEF7] text-[#8B7FA3]\">no operating rows yet</span></td></tr><tr class=\"border-t border-[#F0E8DC]\"><td class=\"px-4 py-2\"><a class=\"font-semibold text-[#5B2A86] hover:underline\" href=\"/os/town/kuruman\">Kuruman</a></td><td class=\"px-4 py-2 text-[#5A4E6D]\">—</td><td class=\"px-4 py-2 text-[#5A4E6D]\">—</td><td class=\"px-4 py-2 text-[#5A4E6D]\">—</td><td class=\"px-4 py-2\"><span class=\"rounded-full px-2 py-0.5 text-[10px] font-semibold bg-[#F3EEF7] text-[#8B7FA3]\">no operating rows yet</span></td></tr><tr class=\"border-t border-[#F0E8DC]\"><td class=\"px-4 py-2\"><a class=\"font-semibold text-[#5B2A86] hover:underline\" href=\"/os/town/de-aar\">De Aar</a></td><td class=\"px-4 py-2 text-[#5A4E6D]\">—</td><td class=\"px-4 py-2 text-[#5A4E6D]\">—</td><td class=\"px-4 py-2 text-[#5A4E6D]\">—</td><td class=\"px-4 py-2\"><span class=\"rounded-full px-2 py-0.5 text-[10px] font-semibold bg-[#F3EEF7] text-[#8B7FA3]\">no operating rows yet</span></td></tr></tbody></table></div></section><section class=\"mt-10\"><h2 class=\"text-sm font-bold uppercase tracking-[0.22em] text-[#8B7FA3]\">Interventions required — evidence-linked</h2><div class=\"mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2\"><div class=\"rounded-2xl border p-5 border-[#E8B4B0] bg-[#FDF1F0] shadow-sm\"><div class=\"flex items-start justify-between gap-3\"><p class=\"text-sm font-medium leading-relaxed text-[#241A33]\">No province-level operating evidence is available for this province yet. Missing: at least one town work or signal row. How to collect: open a town workspace and record the first mission.</p><span class=\"shrink-0 rounded-full border px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide border-[#D98C87] text-[#A63B33]\">Insufficient Evidence</span></div><div class=\"mt-2\"><span class=\"text-xs text-[#A89BB8]\">no evidence rows</span></div></div></div></section><div class=\"mt-8\"><span class=\"text-xs text-[#A89BB8]\">no evidence rows</span></div><section class=\"mt-10 rounded-2xl border border-[#D9C7EA] bg-gradient-to-br from-[#F7F1FB] to-white p-6 shadow-sm\"><div class=\"flex flex-wrap items-baseline justify-between gap-2\"><h2 class=\"text-lg font-bold text-[#5B2A86]\">CHIEF OF STAFF</h2><p class=\"text-xs italic text-[#8B7FA3]\">Northern Cape scope · five modes</p></div><div class=\"mt-4 flex flex-wrap gap-2\" role=\"tablist\" aria-label=\"Chief of Staff modes\"><button role=\"tab\" aria-selected=\"true\" class=\"rounded-full border px-3.5 py-1.5 text-xs font-semibold transition border-[#5B2A86] bg-[#5B2A86] text-white\">OBSERVE</button><button role=\"tab\" aria-selected=\"false\" class=\"rounded-full border px-3.5 py-1.5 text-xs font-semibold transition border-[#D9C7EA] bg-white text-[#5B2A86] hover:bg-[#F3EBFA]\">EXPLAIN</button><button role=\"tab\" aria-selected=\"false\" class=\"rounded-full border px-3.5 py-1.5 text-xs font-semibold transition border-[#D9C7EA] bg-white text-[#5B2A86] hover:bg-[#F3EBFA]\">CHALLENGE</button><button role=\"tab\" aria-selected=\"false\" class=\"rounded-full border px-3.5 py-1.5 text-xs font-semibold transition border-[#D9C7EA] bg-white text-[#5B2A86] hover:bg-[#F3EBFA]\">COACH</button><button role=\"tab\" aria-selected=\"false\" class=\"rounded-full border px-3.5 py-1.5 text-xs font-semibold transition border-[#D9C7EA] bg-white text-[#5B2A86] hover:bg-[#F3EBFA]\">ACT</button></div><p class=\"mt-2 text-xs italic text-[#8B7FA3]\">What is happening?</p><div class=\"mt-4 space-y-3\"><p class=\"rounded-xl border border-[#EADFD2] bg-white p-4 text-sm leading-relaxed text-[#241A33]\">INSUFFICIENT EVIDENCE</p></div></section></div><!--$--><!--/$--></main><div class=\"mx-auto