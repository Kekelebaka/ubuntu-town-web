\\\":\\\"ghost\\\",\\\"render_pct\\\":18,\\\"opportunity_potential\\\":40,\\\"heritage\\\":true,\\\"coordinator_status\\\":\\\"assigned\\\",\\\"route\\\":\\\"/town/thohoyandou\\\",\\\"illustrative\\\":true,\\\"coordinator_name\\\":\\\"Mashudu Tshivhase\\\",\\\"youth_mapped\\\":34,\\\"active_signals\\\":0,\\\"open_opportunities\\\":2,\\\"lat\\\":-23.0833,\\\"lng\\\":29.4833,\\\"description\\\":\\\"The heart of Venda country, Thohoyandou was the capital of the former Venda homeland and remains the cultural centre of the Vhavenda people. The University of Venda and Phiphidi Waterfall are local landmarks.\\\",\\\"population_estimate\\\":80000,\\\"archetype\\\":\\\"cultural_hub\\\",\\\"opportunities\\\":[{\\\"id\\\":\\\"opp-coord-thoh\\\",\\\"title\\\":\\\"Ubuntu Town Coordinator — Thohoyandou\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-thoh\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"coordinator\\\"}}],\\\"businesses\\\":[{\\\"slug\\\":\\\"thohoyandou\\\",\\\"name\\\":\\\"University of Venda\\\",\\\"category\\\":\\\"education\\\",\\\"is_verified\\\":false,\\\"id\\\":\\\"seed-thohoyandou-biz\\\",\\\"town_id\\\":null}]},{\\\"slug\\\":\\\"mokopane\\\",\\\"name\\\":\\\"Mokopane\\\",\\\"region\\\":\\\"Mogalakwena · agriculture \\u0026 mining\\\",\\\"district\\\":\\\"Mogalakwena\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":9,\\\"opportunity_potential\\\":35,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"assigned\\\",\\\"route\\\":\\\"/town/mokopane\\\",\\\"illustrative\\\":true,\\\"coordinator_name\\\":\\\"Sizwe Mabaso\\\",\\\"youth_mapped\\\":42,\\\"active_signals\\\":0,\\\"open_opportunities\\\":1,\\\"lat\\\":-24.1833,\\\"lng\\\":29.0167,\\\"description\\\":\\\"Near the famous Makapansgat Caves where early human fossils were found, Mokopane is a farming town where citrus and cattle thrive in the Limpopo bushveld.\\\",\\\"population_estimate\\\":30000,\\\"archetype\\\":\\\"mining_town\\\",\\\"opportunities\\\":[{\\\"id\\\":\\\"opp-coord-mokop\\\",\\\"title\\\":\\\"Ubuntu Town Coordinator — Mokopane\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-mokop\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"coordinator\\\"}}],\\\"cv_count\\\":1},{\\\"slug\\\":\\\"bela-bela\\\",\\\"name\\\":\\\"Bela-Bela\\\",\\\"region\\\":\\\"Thabazimbi · tourism \\u0026 hot springs\\\",\\\"district\\\":\\\"Thabazimbi\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":38,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/bela-bela\\\",\\\"illustrative\\\":true,\\\"lat\\\":-24.8833,\\\"lng\\\":28.2833,\\\"description\\\":\\\"Hot springs resort town in the Waterberg, popular for wildlife lodges and the Modimolle mountain.\\\"},{\\\"slug\\\":\\\"giyani\\\",\\\"name\\\":\\\"Giyani\\\",\\\"region\\\":\\\"Mopani · Tsonga heartland\\\",\\\"district\\\":\\\"Mopani\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/giyani\\\",\\\"illustrative\\\":true,\\\"lat\\\":-23.2833,\\\"lng\\\":30.7167,\\\"description\\\":\\\"The former capital of Gazankulu, Giyani is a Tsonga-speaking community surrounded by subtropical farmland. The town's community spirit and cultural festivals keep Tsonga traditions alive.\\\",\\\"population_estimate\\\":20000,\\\"archetype\\\":\\\"former_homeland\\\"},{\\\"slug\\\":\\\"lephalale\\\",\\\"name\\\":\\\"Lephalale\\\",\\\"region\\\":\\\"Waterberg · energy \\u0026 coal\\\",\\\"district\\\":\\\"Waterberg\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":38,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/lephalale\\\",\\\"illustrative\\\":true,\\\"lat\\\":-23.6667,\\\"lng\\\":27.7,\\\"description\\\":\\\"Coal mining and power generation hub in the western Waterberg, home to Medupi and Matimba power stations.\\\"},{\\\"slug\\\":\\\"musina\\\",\\\"name\\\":\\\"Musina\\\",\\\"region\\\":\\\"Vhembe · border \\u0026 agriculture\\\",\\\"district\\\":\\\"Vhembe\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":28,\\\"heritage\\\":false,\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/musina\\\",\\\"illustrative\\\":true,\\\"lat\\\":-22.35,\\\"lng\\\":29.7167,\\\"description\\\":\\\"South Africa's northernmost town near the Zimbabwe border, Musina is surrounded by massive baobab trees and the Limpopo River. The town is a gateway to the Great Limpopo Transfrontier Park.\\\",\\\"population_estimate\\\":5000,\\\"archetype\\\":\\\"border_town\\\"},{\\\"slug\\\":\\\"phafula\\\",\\\"name\\\":\\\"Phafula\\\",\\\"region\\\":\\\"rural\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-23.8,\\\"lng\\\":29.3,\\\"description\\\":\\\"Deep in Limpopo's mountain bushveld, Phafula represents the rural heart of the province where community and landscape are inseparable.\\\",\\\"population_estimate\\\":3000,\\\"archetype\\\":\\\"rural\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/phafula\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"tubatse\\\",\\\"name\\\":\\\"Tubatse\\\",\\\"region\\\":\\\"mining town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-24.4833,\\\"lng\\\":29.7333,\\\"description\\\":\\\"A mining and farming community in Limpopo's Sekhukhune district, Tubatse is where mineral wealth meets traditional community life.\\\",\\\"population_estimate\\\":15000,\\\"archetype\\\":\\\"mining_town\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/tubatse\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"limpopo-town\\\",\\\"name\\\":\\\"Limpopo Town\\\",\\\"region\\\":\\\"rural\\\",\\\"status\\\":\\\"ghost\