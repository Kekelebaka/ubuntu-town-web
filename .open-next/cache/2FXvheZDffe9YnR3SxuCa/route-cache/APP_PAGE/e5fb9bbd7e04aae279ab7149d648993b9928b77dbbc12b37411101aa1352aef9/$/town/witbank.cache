ommunity Podcast Producer\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-acornhoek\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"inside_town\\\"}},{\\\"id\\\":\\\"opp-fram-acornhoek-2\\\",\\\"title\\\":\\\"FrameSouth — Town Photographer / Visual Proof Creator\\\",\\\"type\\\":\\\"volunteer\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-acornhoek\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"framesouth\\\"}},{\\\"id\\\":\\\"opp-fixe-acornhoek-3\\\",\\\"title\\\":\\\"FixEasy24 — Verified Service Provider Registration\\\",\\\"type\\\":\\\"opportunity\\\",\\\"source\\\":\\\"ngo\\\",\\\"deadline_date\\\":null,\\\"town_id\\\":\\\"town-acornhoek\\\",\\\"metadata\\\":{\\\"ecosystem\\\":\\\"fixeasy24\\\"}}]},{\\\"slug\\\":\\\"graskop\\\",\\\"name\\\":\\\"Graskop\\\",\\\"region\\\":\\\"panorama route\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-24.9583,\\\"lng\\\":30.825,\\\"description\\\":\\\"The viewing platform at God's Window offers one of South Africa's most famous panoramas — the whole Lowveld stretching to Mozambique below. The Panorama Route through here includes Bourke's Luck Potholes and the Three Rondavels.\\\",\\\"population_estimate\\\":3000,\\\"archetype\\\":\\\"panorama_route\\\",\\\"coordinator_status\\\":\\\"recruiting\\\",\\\"route\\\":\\\"/town/graskop\\\",\\\"illustrative\\\":true},{\\\"slug\\\":\\\"pilgrims-rest\\\",\\\"name\\\":\\\"Pilgrim's Rest\\\",\\\"region\\\":\\\"heritage town\\\",\\\"status\\\":\\\"ghost\\\",\\\"render_pct\\\":0,\\\"opportunity_potential\\\":30,\\\"lat\\\":-24.9667,\\\"lng\\\":30.75,\\\"description\\\":\\\"A perfectly preserved 19th-century gold mining village where the main street looks exactly as it did when prospectors struck it rich. The heritage buildings, Royal Hotel, and mining museum tell the story of the gold rush.\\\",\\\"population_estimate\\\":800,\\\"archetype\\\":\